  "components": {
    "schemas": {
      "Candidate": {
        "properties": {
          "candidate_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Candidate Id"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Address"
          },
          "maps_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Maps Url"
          },
          "latitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Longitude"
          },
          "status": {
            "type": "string",
            "enum": [
              "SUITABLE",
              "UNSUITABLE",
              "UNVERIFIED"
            ],
            "title": "Status"
          },
          "observation_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation Start"
          },
          "observation_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observation End"
          },
          "duration_minutes": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Minutes"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ConditionCheck"
            },
            "type": "array",
            "title": "Checks"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Score"
          },
          "source_refs": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Source Refs"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Candidate"
      },
      "ConditionCheck": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "value": {
            "title": "Value"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "threshold": {
            "title": "Threshold"
          },
          "status": {
            "type": "string",
            "enum": [
              "MET",
              "UNMET",
              "UNKNOWN"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "field",
          "status"
        ],
        "title": "ConditionCheck"
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ConversationOut"
      },
      "DeletedOut": {
        "properties": {
          "deleted": {
            "type": "string",
            "title": "Deleted"
          }
        },
        "type": "object",
        "required": [
          "deleted"
        ],
        "title": "DeletedOut"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "오류 코드. 예: MISSING_API_KEY, NO_RESULT, FORECAST_UNAVAILABLE"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "ErrorInfo"
      },
      "EventListOut": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/EventOut"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "events"
        ],
        "title": "EventListOut"
      },
      "EventOut": {
        "properties": {
          "sequence": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sequence",
            "description": "세션 안의 순번. 저장 전 응답 본문에서는 비어 있다."
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "stage": {
            "type": "string",
            "title": "Stage"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "duration_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Ms"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "type",
          "stage"
        ],
        "title": "EventOut"
      },
      "GroupedConstraints": {
        "properties": {
          "baseline": {
            "additionalProperties": true,
            "type": "object",
            "title": "Baseline",
            "description": "천체, 날짜, 시간대"
          },
          "preference": {
            "additionalProperties": true,
            "type": "object",
            "title": "Preference",
            "description": "지역, 장소 유형"
          },
          "constraint": {
            "additionalProperties": true,
            "type": "object",
            "title": "Constraint",
            "description": "고도, 구름량, 이동시간 같은 제한"
          },
          "empty": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Empty",
            "description": "아직 비어 있는 항목"
          }
        },
        "type": "object",
        "title": "GroupedConstraints"
      },
      "HTTPValidationError": {
        "properties": {
