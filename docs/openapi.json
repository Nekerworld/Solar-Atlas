    "/api/sky/bodies": {
      "get": {
        "summary": "Sky Bodies",
        "description": "천구에 올릴 태양계 천체(위성·왜소행성·소행성·혜성·탐사선)의 적경·적위 표(JPL Horizons).",
        "operationId": "sky_bodies_api_sky_bodies_get",
        "parameters": [
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "title": "Start"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "default": 720,
              "title": "Hours"
            }
          },
          {
            "name": "step_minutes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 120,
              "title": "Step Minutes"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkyBodiesOut"
