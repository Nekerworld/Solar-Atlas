        "P2559": [
          {
            "mainsnak": {
              "snaktype": "value",
              "property": "P2559",
              "hash": "b828da0e5b6d30fedaee155304612e06c01659c0",
              "datavalue": {
                "value": {
                  "text": "an \"instance of\" type metaclass can be theoretically defined for every entity category that has true subclasses (each of the subclasses having at least multiple members), excluding those categories that only contain instances",
                  "language": "en"
                },
                "type": "monolingualtext"
              },
              "datatype": "monolingualtext"
            },
            "type": "statement",
            "id": "Q21146257$d90080e5-4b57-45e7-922e-063b5e801d74",
            "rank": "normal"
          },
          {
            "mainsnak": {
              "snaktype": "value",
              "property": "P2559",
              "hash": "5cde8d71d210b73c1b92504089bcc5710875be66",
              "datavalue": {
                "value": {
                  "text": "Please set items as instances of type of object or specific types of object if possible. Indicating if they are abstract, physical, concrete, individual, fictional or other more specific types of objects provides more detail and helps reduce the amount of maintenance needed later",
                  "language": "en"
                },
                "type": "monolingualtext"
              },
              "datatype": "monolingualtext"
            },
            "type": "statement",
            "id": "Q21146257$625137b5-4bc8-283b-ab9e-0dd109debd0e",
            "rank": "normal"
          }
        ],
