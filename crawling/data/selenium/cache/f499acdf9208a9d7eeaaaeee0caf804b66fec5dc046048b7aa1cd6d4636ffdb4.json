                  "hash": "2cdb2125bbb331546c4c6659d93ba62c93935da8",
                  "datavalue": {
                    "value": {
                      "text": "The mediocrity principle is a philosophical notion, which is rooted in mathematics and/or statistics: “if an item is drawn at random from one of several sets or categories, it’s likelier to come from the most numerous category than from any one of the less numerous categories” (Wiki). Hence, human life would be about Joe Average and Sixpack Annie.",
                      "language": "en"
                    },
                    "type": "monolingualtext"
                  },
                  "datatype": "monolingualtext"
                }
