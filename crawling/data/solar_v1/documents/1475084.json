    },
    {
      "id": "p11",
      "section": "같이 보기",
      "kind": "li",
      "text": "찬드라얀 2호"
    },
    {
      "id": "p12",
      "section": "같이 보기",
      "kind": "li",
      "text": "루나 플래쉬라이트"
    },
    {
