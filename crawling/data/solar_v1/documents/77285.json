  "raw_html": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"ko\" dir=\"ltr\"><table class=\"infobox\" style=\"margin-left: 1em; float:right; width: 23em; font-size:85%\">\n\n<tbody><tr>\n<td colspan=\"2\" style=\"background:#FFC0C0; color:#000000; text-align:center;\"><big><big><b>포보스</b></big></big> <br /><span style=\"font-size:90%;\">Phobos</span>\n</td></tr>\n\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><span typeof=\"mw:File\"><a href=\"/wiki/%ED%8C%8C%EC%9D%BC:Phobos_colour_2008.jpg\" class=\"mw-file-description\"><img alt=\"화성 정찰위성이 촬영한 포보스.\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Phobos_colour_2008.jpg/250px-Phobos_colour_2008.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"236\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Phobos_colour_2008.jpg/500px-Phobos_colour_2008.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3500\" data-file-height=\"3300\" /></a></span><br /><a href=\"/wiki/%ED%99%94%EC%84%B1_%EC%A0%95%EC%B0%B0%EC%9C%84%EC%84%B1\" title=\"화성 정찰위성\">화성 정찰위성</a>이 촬영한 포보스.\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" colspan=\"2\">발견\n</th></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">발견자 </span>\n</th>\n<td><a href=\"/wiki/%EC%95%84%EC%82%AC%ED%94%84_%ED%99%80\" title=\"아사프 홀\">아사프 홀</a>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">발견일 </span>\n</th>\n<td><a href=\"/wiki/1877%EB%85%84\" title=\"1877년\">1877년</a> <a href=\"/wiki/8%EC%9B%94_17%EC%9D%BC\" title=\"8월 17일\">8월 17일</a>\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" bgcolor=\"#EAEAEA\" colspan=\"2\">명칭\n</th></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">다른 이름 </span>\n</th>\n<td>화성 I\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" bgcolor=\"#EAEAEA\" colspan=\"3\">궤도 성질 <br />\n</th></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%96%89%EC%84%B1\" title=\"행성\">모행성</a> </span>\n</th>\n<td><a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">화성</a>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">궤도 <a href=\"/wiki/%EA%B8%B4%EB%B0%98%EC%A7%80%EB%A6%84\" title=\"긴반지름\">긴반지름</a>(a) </span>\n</th>\n<td>9,376 <a href=\"/wiki/%ED%82%AC%EB%A1%9C%EB%AF%B8%ED%84%B0\" title=\"킬로미터\">km</a>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%9E%A5%EC%B6%95%EB%8B%A8\" title=\"장축단\">근점</a>(q) </span>\n</th>\n<td>9,234.42 km\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%9E%A5%EC%B6%95%EB%8B%A8\" title=\"장축단\">원점</a>(Q) </span>\n</th>\n<td>9,517.58 km\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B3%B5%EC%A0%84_%EC%A3%BC%EA%B8%B0\" title=\"공전 주기\">공전 주기</a>(P) </span>\n</th>\n<td>7시간 39분 12초\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%8F%89%EA%B7%A0_%EA%B3%B5%EC%A0%84_%EC%86%8D%EB%8F%84\" class=\"mw-redirect\" title=\"평균 공전 속도\">평균 공전 속도</a> </span>\n</th>\n<td>2.138 km/s\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B6%A4%EB%8F%84_%EA%B2%BD%EC%82%AC\" title=\"궤도 경사\">궤도 경사</a>(i) </span>\n</th>\n<td>1.093 <a href=\"/wiki/%EB%8F%84_(%EA%B0%81%EB%8F%84)\" title=\"도 (각도)\">°</a> (화성 적도 기준)\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B6%A4%EB%8F%84_%EC%9D%B4%EC%8B%AC%EB%A5%A0\" title=\"궤도 이심률\">궤도 이심률</a>(e) </span>\n</th>\n<td>0.0151\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" colspan=\"2\">물리적 성질\n</th></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EB%B0%98%EC%A7%80%EB%A6%84\" title=\"반지름\">반지름</a> </span>\n</th>\n<td>11.2667 km\n</td></tr>\n\n\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%91%9C%EB%A9%B4%EC%A0%81\" class=\"mw-redirect\" title=\"표면적\">표면적</a> </span>\n</th>\n<td>1,548.3 km<sup>2</sup>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EB%B6%80%ED%94%BC\" title=\"부피\">부피</a> </span>\n</th>\n<td>5,783.61 <a href=\"/wiki/%ED%82%AC%EB%A1%9C%EB%AF%B8%ED%84%B0\" title=\"킬로미터\">km</a><sup>3</sup>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">평균 <a href=\"/wiki/%EB%B0%80%EB%8F%84\" title=\"밀도\">밀도</a> </span>\n</th>\n<td>1.876 g/cm<sup>3</sup>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%A7%88%EB%9F%89\" title=\"질량\">질량</a> </span>\n</th>\n<td>1.0659×10<span style=\"display:none\">^</span><sup>16</sup> kg\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">표면 <a href=\"/wiki/%EC%A4%91%EB%A0%A5\" title=\"중력\">중력</a> </span>\n</th>\n<td>0.0057 <a href=\"/wiki/%EA%B0%80%EC%86%8D%EB%8F%84\" title=\"가속도\">m/s<sup>2</sup></a>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%83%88%EC%B6%9C_%EC%86%8D%EB%8F%84\" title=\"탈출 속도\">탈출 속도</a> </span>\n</th>\n<td>11.39 m/s\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EB%B0%98%EC%82%AC%EC%9C%A8\" title=\"반사율\">반사율</a> </span>\n</th>\n<td>0.071<sup id=\"cite&#95;ref-jplssd&#95;1-0\" class=\"reference\"><a href=\"#cite_note-jplssd-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">자전 주기 </span>\n</th>\n<td>7시간 39분 12초<br />(<a href=\"/wiki/%EC%A1%B0%EC%84%9D_%EA%B3%A0%EC%A0%95\" title=\"조석 고정\">동주기 자전</a>)\n</td></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%9E%90%EC%A0%84%EC%B6%95_%EA%B8%B0%EC%9A%B8%EA%B8%B0\" title=\"자전축 기울기\">자전축 기울기</a> </span>\n</th>\n<td>0°\n</td></tr>\n\n\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">평균 <a href=\"/wiki/%EC%98%A8%EB%8F%84\" title=\"온도\">온도</a> </span>\n</th>\n<td>~ 233 <a href=\"/wiki/%EC%BC%88%EB%B9%88\" title=\"켈빈\">K</a>\n</td></tr>\n\n\n</tbody></table>\n<p><b>포보스</b>(<span style=\"font-size: smaller;\"><a href=\"/wiki/%EC%98%81%EC%96%B4\" title=\"영어\">영어</a>&#58; </span><span lang=\"en\">Phobos</span>)는 <a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">화성</a>의 두 <a href=\"/wiki/%EC%9C%84%EC%84%B1\" title=\"위성\">위성</a> 중 하나이다. <a href=\"/wiki/1877%EB%85%84\" title=\"1877년\">1877년</a> <a href=\"/wiki/8%EC%9B%94_18%EC%9D%BC\" title=\"8월 18일\">8월 18일</a>에 <a href=\"/wiki/%EB%AF%B8%EA%B5%AD\" title=\"미국\">미국</a>의 천문학자 <a href=\"/wiki/%EC%95%84%EC%82%AC%ED%94%84_%ED%99%80\" title=\"아사프 홀\">아사프 홀</a>이 발견했다. 홀이 동시에 발견한 또 다른 화성의 위성인 <a href=\"/wiki/%EB%8D%B0%EC%9D%B4%EB%AA%A8%EC%8A%A4_(%EC%9C%84%EC%84%B1)\" title=\"데이모스 (위성)\">데이모스</a>보다 크며, 비교적 안쪽 궤도를 돈다. 포보스는 그리스 신화에 나오는 신의 이름인, <a href=\"/wiki/%EC%95%84%EB%A0%88%EC%8A%A4\" title=\"아레스\">아레스</a>의 아들 <a href=\"/wiki/%ED%8F%AC%EB%B3%B4%EC%8A%A4_(%EC%8B%A0%ED%99%94)\" title=\"포보스 (신화)\">포보스</a>('공포'를 의미한다)에서 따왔다.\n</p><p>포보스는 작으며 불규칙한 모양을 하고 있는데, 화성의 중심부에서 9,377&#160;km, 표면에서 6,000&#160;km 떨어진 곳을 돌고 있다. 이 거리는 <a href=\"/wiki/%ED%83%9C%EC%96%91%EA%B3%84\" title=\"태양계\">태양계</a> 내 어떤 위성들보다도 <a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">어머니 행성</a>과 가까운 값이다.\n</p><p>포보스는 매 100년마다 1m씩 <a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">화성</a> 표면에 가까워지고 있다. 따라서 5000만 년 뒤에는 <a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">화성</a> 표면과 충돌하거나 <a href=\"/wiki/%ED%96%89%EC%84%B1%EC%9D%98_%EA%B3%A0%EB%A6%AC\" title=\"행성의 고리\">화성의 고리</a>가 됨으로써 깨어지게 될 것으로 예측된다.<sup id=\"cite&#95;ref-phobos&#95;2-0\" class=\"reference\"><a href=\"#cite_note-phobos-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup> 포보스의 표면기온은 햇볕 드는 곳과 그림자 지는 곳에서 각각 영하 4도 ~ 영하 170도 범위에 든다.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"같이_보기\"><span id=\".EA.B0.99.EC.9D.B4_.EB.B3.B4.EA.B8.B0\"></span>같이 보기</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%ED%8F%AC%EB%B3%B4%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;veaction=edit&amp;section=1\" title=\"문단 편집: 같이 보기\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=%ED%8F%AC%EB%B3%B4%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;action=edit&amp;section=1\" title=\"문단의 원본 코드 편집: 같이 보기\"><span>원본 편집</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/%EC%9C%84%EC%84%B1_%EB%AA%A9%EB%A1%9D\" title=\"위성 목록\">위성 목록</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"각주\"><span id=\".EA.B0.81.EC.A3.BC\"></span>각주</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%ED%8F%AC%EB%B3%B4%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;veaction=edit&amp;section=2\" title=\"문단 편집: 각주\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=%ED%8F%AC%EB%B3%B4%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;action=edit&amp;section=2\" title=\"문단의 원본 코드 편집: 각주\"><span>원본 편집</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-references-wrap\"><ol class=\"references\">\n<li id=\"cite&#95;note-jplssd-1\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-jplssd_1-0\">↑</a></span> <span class=\"reference-text\"><cite class=\"citation web\"><a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"http://ssd.jpl.nasa.gov/?sat_phys_par\" href=\"https://ssd.jpl.nasa.gov/?sat_phys_par\">&#8220;Planetary Satellite Physical Parameters&#8221;</a>. <a href=\"/wiki/JPL\" class=\"mw-redirect\" title=\"JPL\">JPL</a> (Solar System Dynamics)<span class=\"reference-accessdate\">. 2008년 1월 29일에 확인함</span>.</cite><span title=\"ctx&#95;ver=Z39.88-2004&amp;rft&#95;val&#95;fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=Planetary+Satellite+Physical+Parameters&amp;rft.pub=JPL+%28Solar+System+Dynamics%29&amp;rft&#95;id=http%3A%2F%2Fssd.jpl.nasa.gov%2F%3Fsat&#95;phys&#95;par&amp;rfr&#95;id=info%3Asid%2Fko.wikipedia.org%3A%ED%8F%AC%EB%B3%B4%EC%8A%A4+%28%EC%9C%84%EC%84%B1%29\" class=\"Z3988\"><span style=\"display:none;\">&#160;</span></span></span>\n</li>\n<li id=\"cite&#95;note-phobos-2\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-phobos_2-0\">↑</a></span> <span class=\"reference-text\"><cite class=\"citation web\"><a rel=\"nofollow\" class=\"external text\" href=\"https://web.archive.org/web/20140624191709/https://solarsystem.nasa.gov/planets/profile.cfm?Object=Mar_Phobos#\">&#8220;NASA - Phobos&#8221;</a>. 2014년 6월 24일에 <a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"http://solarsystem.nasa.gov/planets/profile.cfm?Object=Mar_Phobos#\" href=\"https://solarsystem.nasa.gov/planets/profile.cfm?Object=Mar_Phobos#\">원본 문서</a>에서 보존된 문서<span class=\"reference-accessdate\">. 2013년 11월 8일에 확인함</span>.</cite><span title=\"ctx&#95;ver=Z39.88-2004&amp;rft&#95;val&#95;fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=NASA+-+Phobos&amp;rft&#95;id=http%3A%2F%2Fsolarsystem.nasa.gov%2Fplanets%2Fprofile.cfm%3FObject%3DMar&#95;Phobos%23&amp;rfr&#95;id=info%3Asid%2Fko.wikipedia.org%3A%ED%8F%AC%EB%B3%B4%EC%8A%A4+%28%EC%9C%84%EC%84%B1%29\" class=\"Z3988\"><span style=\"display:none;\">&#160;</span></span></span>\n</li>\n</ol></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"외부_링크\"><span id=\".EC.99.B8.EB.B6.80_.EB.A7.81.ED.81.AC\"></span>외부 링크</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/