          "text": "{\"topics\":[{\"topic\":\"소행성대 탐사\",\"query\":\"소행성대 탐사 우주선 임무\",\"reason\":\"제공된 사실에는 소행성대 탐사 임무나 직접 관측에 관한 내용이 없다.\",\"question\":\"소행성대를 직접 탐사한 임무와 그 관측 성과는 무엇인가?\"},{\"topic\":\"소행성대 관측과 불확실성\",\"query\":\"소행성대 관측 소행성 분광형 질량 불확실성\",\"reason\":\"분광형과 궤도 분포는 제시되어 있지만 관측 방법과 자료의 한계는 충분히 설명되지 않았다.\",\"question\":\"소행성대의 구성과 분포를 판단하는 관측 방법 및 주요 불확실성은 무엇인가?\"},{\"topic\":\"소행성대의 경계와 구조\",\"query\":\"소행성대 경계 커크우드 간극 주 소행성대\",\"reason\":\"안쪽 경계와 핵심부의 정의는 제시되어 있으나 전체 영역의 경계와 구조를 더 확인할 수 있다.\",\"question\":\"소행성대의 경계와 주 소행성대의 범위는 어떤 기준으로 정의되는가?\"}],\"questions\":[{\"question\":\"소행성대를 탐사한 임무와 직접 관측 성과를 확인할 수 있는가?\",\"required_fields\":[\"탐사\"]},{\"question\":\"소행성대의 구성·분포에 관한 관측 근거와 자료의 불확실성을 구분해 설명할 수 있는가?\",\"required_fields\":[\"관측 근거와 불확실성\"]}],\"coverage\":[{\"field\":\"정의와 범위\",\"status\":\"found\",\"fact_indices\":[0,2,6,13,14]},{\"field\":\"구성 천체\",\"status\":\"found\",\"fact_indices\":[1,8,9,10,11]},{\"field\":\"구조와 분포\",\"status\":\"found\",\"fact_indices\":[4,5,6,7,9,10,11,12,13,14]},{\"field\":\"형성과 기원 가설\",\"status\":\"found\",\"fact_indices\":[15,16,17,18,19]},{\"field\":\"관측 근거와 불확실성\",\"status\":\"found\",\"fact_indices\":[3,7,11,12]},{\"field\":\"탐사\",\"status\":\"needs_research\",\"fact_indices\":[]}]}"
