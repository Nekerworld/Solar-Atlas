          "logprobs": [],
          "text": "{\"facts\":[{\"field\":\"행성의 지위와 크기 순위\",\"value\":\"목성은 태양계의 다섯 번째 행성이며 태양계에서 가장 큰 행성이다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"태양계 의 다섯 번째 행성 이자 가장 큰 행성이다\"}]},{\"field\":\"구성 물질과 표면\",\"value\":\"주로 수소로 이루어져 있고, 기체 및 액체 물질이 주성분이며 뚜렷한 고체 표면은 없다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p2\",\"quote\":\"목성은 주로 수소 로 이루어져 있다\"},{\"paragraph_id\":\"p2\",\"quote\":\"다른 거대 행성들과 같이 뚜렷한 고체 표면이 없다\"},{\"paragraph_id\":\"p7\",\"quote\":\"목성은 주로 기체 및 액체 물질로 이루어져 있다\"}]},{\"field\":\"질량\",\"value\":\"지구 질량의 약 318배이며, 태양계의 다른 모든 행성 질량을 합한 값의 약 2.5배이다.\",\"unit\":null,\"measurement_basis\":\"지구 및 태양계의 다른 행성들과 비교\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p11\",\"quote\":\"목성은 지구보다 단 318 배 밖에 크지 않기 때문이다\"},{\"paragraph_id\":\"p11\",\"quote\":\"목성의 질량은 태양계의 다른 모든 행성을 합한 질량의 2.5 배로\"}]},{\"field\":\"적도 직경\",\"value\":\"142,984 km\",\"unit\":\"km\",\"measurement_basis\":\"적도에서 측정한 직경\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"목성의 직경은 적도 에서 142,984 km\"}]},{\"field\":\"편평도와 적도 팽대\",\"value\":\"빠른 자전으로 편구형이며, 적도 지름이 극 지름보다 9,275 km 더 길다.\",\"unit\":\"km\",\"measurement_basis\":\"적도 지름과 극 지름의 차이\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p35\",\"quote\":\"목성의 적도 지름은 극 지름보다 9,275 km(5,763 mi) 더 길다\"},{\"paragraph_id\":\"p2\",\"quote\":\"빠른 자전으로 인해서 행성의 모양은 편구\"}]},{\"field\":\"평균 밀도\",\"value\":\"1.326 g/cm³\",\"unit\":\"g/cm³\",\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"밀도 는 1.326 g/cm 3\"}]},{\"field\":\"상층 대기 조성\",\"value\":\"개수 밀도 기준으로 수소 약 88~92%, 헬륨 약 8~12%이다. 질량 기준으로는 대기가 약 75% 수소와 24% 헬륨이며, 나머지 약 1%는 다른 원소들이다.\",\"unit\":\"%\",\"measurement_basis\":\"상층 대기 비율은 개수 밀도 기준이며, 별도로 질량 기준 조성도 제시됨\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p8\",\"quote\":\"목성의 상층부 대기 는 약 88 ~ 92%의 수소 와 8 ~ 12%의 헬륨 으로 이루어져 있다\"},{\"paragraph_id\":\"p8\",\"quote\":\"이는 개수 밀도 조성비인데\"},{\"paragraph_id\":\"p8\",\"quote\":\"질량에 따른 목성의 대기는 약 75%의 수소와 24%의 헬륨으로 구성되어 있으며, 나머지 일 퍼센트만이 다른 원소들로 이루어져 있다\"}]},{\"field\":\"대기 중 미량 성분\",\"value\":\"대기에는 미량의 메테인, 수증기, 암모니아, 규소 화합물 등이 포함되며, 최외곽층에는 얼음 암모니아 결정이 있다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p8\",\"quote\":\"목성의 대기는 미량의 메테인 , 수증기 , 암모니아 , 규소 화합물 을 포함\"},{\"paragraph_id\":\"p8\",\"quote\":\"대기의 최외곽층은 얼음 암모니아 결정 을 포함한다\"}]},{\"field\":\"대기 시작점의 기준\",\"value\":\"고체 지표면이 없으므로 대기의 시작점은 주로 압력 1 MPa(10 bar)인 지점으로 간주된다.\",\"unit\":\"MPa (bar)\",\"measurement_basis\":\"대기의 시작점을 정하기 위한 관례적 기준\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p19\",\"quote\":\"지표면이 없기 때문에, 대기의 시작점은 주로 대기압이 1 MPa (10 바 ), 또는 지구의 표면 압력의 열 배에 해당하는 지점으로 간주된다\"}]},{\"field\":\"자전 주기와 차등 회전\",\"value\":\"자전 주기는 위도에 따라 다르다. 적도 부근을 적용하는 제일회전계는 9시간 50분 30초이고, 공식 자전 주기로 쓰이는 제삼회전계는 9시간 55분 40.6초이다.\",\"unit\":\"시간\",\"measurement_basis\":\"대기 자전의 위도별 회전계 기준; 제삼회전계는 자기권 자전과 관련됨\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p36\",\"quote\":\"제일회전계의 자전주기는 9시간 50분 30초로 목성에서 가장 짧다\"},{\"paragraph_id\":\"p36\",\"quote\":\"제삼회전계( System III )는 전파천문학자 들이 처음으로 밝혀낸 것으로, 목성 자기권의 자전과 상관있다\"},{\"paragraph_id\":\"p36\",\"quote\":\"제3 회전계의 자전주기는 목성의 공식적인 자전 주기로 쓰인다\"}]},{\"field\":\"공전 주기\",\"value\":\"태양을 한 바퀴 도는 데 11.86년이 걸린다.\",\"unit\":\"년\",\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p33\",\"quote\":\"11.86년마다 한 번씩 공전을 완주한다\"}]},{\"field\":\"평균 태양 거리\",\"value\":\"약 7억 7,800만 km, 즉 약 5.2 AU이다.\",\"unit\":\"km; AU\",\"measurement_basis\":\"태양과 목성 사이의 평균 거리\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p33\",\"quote\":\"목성과 태양 사이의 평균 거리는 7억 7,800만 km (지구와 태양 사이의 평균 거리의 5.2배, 즉 5.2 AU )\"}]},{\"field\":\"궤도 이심률\",\"value\":\"약 0.048\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p33\",\"quote\":\"0.048의 궤도 이심률\"}]},{\"field\":\"궤도 경사\",\"value\":\"지구 궤도에 대해 1.31° 기울어져 있다.\",\"unit\":\"°\",\"measurement_basis\":\"지구 궤도에 대한 목성 궤도의 기울기\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p33\",\"quote\":\"목성의 타원 궤도는 지구에 대해 1.31˚ 기울어져 있다\"}]},{\"field\":\"자전축 경사\",\"value\":\"약 3.13°\",\"unit\":\"°\",\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p34\",\"quote\":\"목성의 자전축 경사 는 약 3.13˚\"}]},{\"field\":\"목성 대기의 띠와 바람\",\"value\":\"대기의 구름은 밝은 대와 어두운 띠로 배열된다. 국지 제트의 풍속은 100 m/s(360 km/h)인 경우가 흔하다.\",\"unit\":\"m/s; km/h\",\"measurement_basis\":\"목성 대기의 국지 제트 바람\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p20\",\"quote\":\"이들은 밝은 색조의 대( zone )와 어두운 색조의 띠( belt )로 나뉜다\"},{\"paragraph_id\":\"p20\",\"quote\":\"국지 제트(zonal jet)에서는 풍속 100 m/s (360 km/h)의 바람이 흔하게 발생한다\"}]},{\"field\":\"대적점\",\"value\":\"대적점은 적도 남쪽 약 22°에 위치한 오래 유지되는 고기압성 폭풍이다. 적어도 1831년부터, 또는 1665년부터 존재했을 가능성이 있다고 서술되어 있다.\",\"unit\":\"°\",\"measurement_basis\":\"위치는 적도 기준 남위; 존속 시점은 문단에 제시된 관측 기록의 불확실성을 반영\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p24\",\"quote\":\"대적점은 오랫동안 유지되고 있는 고기압성 폭풍 으로, 적도 를 기준으로 남위 22˚에 위치해 있으며 지구보다 더 크다\"},{\"paragraph_id\":\"p24\",\"quote\":\"대적점은 최소한 1831년, 또는 1665년 이후부터 존재해왔다\"}]},{\"field\":\"대기 구름층\",\"value\":\"구름은 암모니아 결정과 아마도 황화 수소 암모늄으로 이루어져 있다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p20\",\"quote\":\"목성은 암모니아 결정 및 아마 황화 수소 암모늄 으로 구성된 구름에 영구적으로 뒤덮혀 있다\"}]},{\"field\":\"내부 구조\",\"value\":\"여러 원소가 섞인 고밀도 핵, 액상 금속성 수소층, 주로 수소 분자로 된 외곽층으로 이루어진 것으로 여겨지지만, 구조에는 상당한 불확실성이 있다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p14\",\"quote\":\"목성은 여러 원소 들이 혼합된 고밀도의 핵과 그 주변의 액상 금속성 수소 층, 대부분 수소 분자로 구성된 외곽층으로 이루어진 것으로 여겨진다\"},{\"paragraph_id\":\"p14\",\"quote\":\"이런 구조에 관해 더 상세한 내용은 아직 까지도 상당한 불확실성이 존재한다\"}]},{\"field\":\"핵 질량 추정\",\"value\":\"중력 측량을 바탕으로 핵 질량이 지구 질량의 약 12~45배, 또는 목성 전체 질량의 약 4~14%라고 제시된 바 있다.\",\"unit\":\"지구 질량; 목성 전체 질량 대비 %\",\"measurement_basis\":\"1997년 중력 측량에 근거한 추정\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p14\",\"quote\":\"1997년, 핵의 존재가 여러 중력 측량을 통해 주장 되었는데, 그 질량은 지구의 질량의 약 12~45 배 또는 목성의 총 질량의 대략 4~14 %이다\"}]},{\"field\":\"고리계\",\"value\":\"희미한 고리계를 가지고 있으며, 고리들은 토성 고리의 얼음과 달리 티끌로 이루어진 것으로 보인다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p29\",\"quote\":\"목성은 이루어진 희미한 고리계 를 가지고 있다\"},{\"paragraph_id\":\"p29\",\"quote\":\"이러한 고리들은 토성의 고리에서 볼 수 있는 얼음 보다는 티끌 로 이루어진 것으로 보인다\"}]},{\"field\":\"자기장\",\"value\":\"자기장은 적도에서 4.2 가우스이며, 지구 자기장보다 14배 강하다고 서술되어 있다.\",\"unit\":\"가우스\",\"measurement_basis\":\"적도에서의 자기장 세기 및 지구 자기장과의 비교\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"목성의 자기장 은 적도 에서 4.2 가우스 (0.42 mT )\"},{\"paragraph_id\":\"p30\",\"quote\":\"지구의 자기장보다 14 배나 강하며\"}]},{\"field\":\"위성 수\",\"value\":\"적어도 79개의 위성을 가진다고 서술되어 있다.\",\"unit\":\"개\",\"measurement_basis\":\"문단에 제시된 최소 개수\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p2\",\"quote\":\"적어도 79개의 위성 을 가지고 있다\"}]}]}"
        }
