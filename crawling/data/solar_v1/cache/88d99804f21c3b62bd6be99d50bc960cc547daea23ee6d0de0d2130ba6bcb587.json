          "text": "{\"facts\":[{\"field\":\"발견일\",\"value\":\"2003년 11월 14일\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p5\",\"quote\":\"2003년 11월 14일\"}]},{\"field\":\"태양과의 거리\",\"value\":\"2018년 4월 11일 기준 85.14 AU\",\"unit\":\"AU\",\"measurement_basis\":\"해당 날짜 기준 태양계 천체 거리 표\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p32\",\"quote\":\"2018년 4월 11일 기준으로 태양계 에서 가장 먼 천체들\"},{\"paragraph_id\":\"p32\",\"quote\":\"세드나 85.14\"}]},{\"field\":\"근일점 거리\",\"value\":\"약 76 AU\",\"unit\":\"AU\",\"measurement_basis\":\"궤도 계산값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"근일점 거리가 약 76 AU\"}]},{\"field\":\"원일점 거리\",\"value\":\"약 937 AU\",\"unit\":\"AU\",\"measurement_basis\":\"궤도 계산값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"원일점 거리가 약 937 AU\"}]},{\"field\":\"공전 주기\",\"value\":\"약 11,400년\",\"unit\":\"년\",\"measurement_basis\":\"계산값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"11,400년 전후로 계산된다\"}]},{\"field\":\"궤도 이심률\",\"value\":\"0.85491 ± 0.00029\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p31\",\"quote\":\"궤도 이심률 (e) 0.85491±0.00029\"}]},{\"field\":\"직경\",\"value\":\"995 ± 80 km\",\"unit\":\"km\",\"measurement_basis\":\"2012년 허셜 우주망원경 관측\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p9\",\"quote\":\"2012년, 허셜 우주망원경 의 장비로 관측한 결과 세드나의 직경은 995 ± 80 킬로미터\"}]},{\"field\":\"직경\",\"value\":\"995 ± 80 km\",\"unit\":\"km\",\"measurement_basis\":\"열물리 모형\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p31\",\"quote\":\"지름 995 ± 80 km (열물리 모형)\"}]},{\"field\":\"직경\",\"value\":\"1060 ± 100 km\",\"unit\":\"km\",\"measurement_basis\":\"고전 열 모형\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p31\",\"quote\":\"1060 ± 100 km (고전 열 모형)\"}]},{\"field\":\"자전 주기\",\"value\":\"10.3시간 ± 30%\",\"unit\":\"시간\",\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p31\",\"quote\":\"자전 주기 10.3 h ± 30%\"}]},{\"field\":\"자전 주기\",\"value\":\"약 10시간으로 측정됨\",\"unit\":\"시간\",\"measurement_basis\":\"MMT 천문대 망원경 측정\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p8\",\"quote\":\"MMT 천문대 의 망원경으로 다시 측정한 결과 자전주기는 초기값보다 훨씬 짧은 10시간\"}]},{\"field\":\"표면 색\",\"value\":\"가시광선 대역에서 태양계 천체 중 가장 붉은 축에 속하며 거의 화성만큼 붉음\",\"unit\":null,\"measurement_basis\":\"SMARTS 망원경 관측\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p10\",\"quote\":\"세드나는 가시광선 대역에서 태양계의 천체들 중 가장 붉은 축에 속한다는 것이 밝혀졌다. 거의 화성 만큼 붉다.\"}]},{\"field\":\"표면 조성\",\"value\":\"분광분석에 따르면 주로 물, 메탄, 질소, 얼음, 톨린 등이 혼합되어 있음\",\"unit\":null,\"measurement_basis\":\"분광분석\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"분광분석 결과 세드나의 표면은 주로 물, 메탄 , 질소 , 얼음, 톨린 등이 혼합되어 있어\"}]},{\"field\":\"표면 조성 비율 추정\",\"value\":\"트리톤형 톨린 24%, 비결정형 탄소 7%, 질소 10%, 메탄올 26%, 메탄 33%일 것으로 추측됨\",\"unit\":\"%\",\"measurement_basis\":\"분광을 트리톤의 분광과 비교한 추정\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p11\",\"quote\":\"이 관측을 토대로 그들은 세드나의 표면 조성이 트리톤형 톨린 24%, 비결정형 탄소 7%, 질소 10%, 메탄올 26%, 메탄 33%일 것이라고 추측했다.\"}]},{\"field\":\"위성 관측\",\"value\":\"2004년 허블 우주망원경 관측에서 동반천체 또는 위성을 찾지 못함\",\"unit\":null,\"measurement_basis\":\"허블 우주망원경 탐색\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p8\",\"quote\":\"2004년 3월 허블 우주망원경 으로 그러한 동반천체 또는 위성이 있는지 찾아보았지만 아무것도 없었다.\"}]},{\"field\":\"질량 측정\",\"value\":\"위성이 없어 현재로서는 우주탐사선을 직접 보내는 방법 외에 질량을 알아낼 방법이 없다고 서술됨\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p9\",\"quote\":\"세드나는 위성이 없기 때문에 현재로서 그 질량을 알아낼 방법은 우주탐사선 을 직접 보내는 방법 외에는 없다.\"}]},{\"field\":\"분류\",\"value\":\"소행성체센터는 산란원반 천체로 분류하지만, 이 분류에는 상당한 의문이 제기되어 있음\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p24\",\"quote\":\"소행성체센터 는 세드나를 산란원반 천체로 분류하고 있다. 그러나 이 분류에 대해서는 상당히 심한 의문이 제기되고 있으며\"}]},{\"field\":\"왜행성 후보 여부\",\"value\":\"유력한 왜행성 후보로 언급되며, 많은 천문학자들은 왜행성이라고 부르고 있으나 정역학적 평형 조건을 만족할 것으로 예상된다는 수준임\",\"unit\":null,\"measurement_basis\":null,\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"유력한 왜행성 후보이다.\"},{\"paragraph_id\":\"p25\",\"quote\":\"세드나는 충분히 밝고 그러므로 충분히 클 것이므로 이 조건을 만족시킬 것으로 예상된다. 그래서 많은 천문학자들은 세드나를 왜행성이라고 부르고 있다.\"}]},{\"field\":\"기원 가설\",\"value\":\"세드나가 내부 오르트 구름 천체라는 해석이 제안되어 있음\",\"unit\":null,\"measurement_basis\":null,\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p13\",\"quote\":\"연구진은 세드나를 “내부 오르트 구름 천체”라고 했다.\"}]},{\"field\":\"기원 가설\",\"value\":\"태양의 탄생성단에서 지나가는 항성의 영향으로 현재 궤도를 얻었을 가능성이 제안됨\",\"unit\":null,\"measurement_basis\":\"연구진의 궤도 해석 및 시뮬레이션에 근거한 가설\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p15\",\"quote\":\"연구진은 세드나의 궤도를 설명하는 가장 그럴듯한 가설은 태양은 탄생할 때 여러 항성들과 함께 태어나 산개성단 을 이루었고, 시간이 지나면서 항성들이 흩어졌다는 것이라고 제안했다.\"}]},{\"field\":\"내부 바다 가능성\",\"value\":\"방사성 감쇠에 따른 내부열 모형은 표면 아래 액체 물 바다가 있을 가능성을 지지함\",\"unit\":null,\"measurement_basis\":\"방사성 감쇠를 통한 내부열 모형\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p12\",\"quote\":\"방사성 감쇠 를 통한 내부열 모형은 세드나의 표면 아래에 액체 상태의 물로 된 바다가 있을 수 있다는 설을 지지한다.\"}]}]}"
