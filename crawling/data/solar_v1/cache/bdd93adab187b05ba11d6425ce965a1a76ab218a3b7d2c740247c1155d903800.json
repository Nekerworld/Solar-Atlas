          "logprobs": [],
          "text": "{\"fields\":[{\"field\":\"크기와 측정 기준\",\"status\":\"covered\",\"reason\":\"지구와 비교한 표면적이 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p6\",\"quote\":\"화성의 표면적은 지구 의 4분의 1밖에 되지 않으며\"}]},{\"field\":\"질량\",\"status\":\"covered\",\"reason\":\"지구 질량과의 비교값이 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p6\",\"quote\":\"질량은 10분의 1밖에 되지 않는다\"}]},{\"field\":\"밀도\",\"status\":\"needs_research\",\"reason\":\"내부의 밀도 차이에 대한 설명은 있으나 행성의 평균 밀도값은 확인되지 않습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p9\",\"quote\":\"밀도가 낮은 물질로 중첩된 고밀도 금속 중심부로 분화했다\"}]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"reason\":\"지구와 비슷하다는 설명뿐이며 자전 주기와 태양일의 구체적인 값은 없습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p4\",\"quote\":\"화성의 자전 주기와 계절의 변화 주기는 지구와 비슷하다.\"}]},{\"field\":\"공전과 궤도\",\"status\":\"needs_research\",\"reason\":\"궤도 이심률은 제시되어 있지만 공전 주기와 궤도의 주요 수치가 충분하지 않습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p21\",\"quote\":\"화성의 궤도 이심률 은 약 7%로 상대적으로 큰 편이다.\"}]},{\"field\":\"구조와 조성\",\"status\":\"covered\",\"reason\":\"표면의 기본 암석과 금속 중심부를 포함한 내부 분화가 설명되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p7\",\"quote\":\"화성의 표면은 기본적으로 현무암 으로 되어 있다.\"},{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p9\",\"quote\":\"고밀도 금속 중심부로 분화했다\"}]},{\"field\":\"관측과 탐사\",\"status\":\"covered\",\"reason\":\"망원경 관측 및 우주 탐사선의 관측·탐사 사례가 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p36\",\"quote\":\"매리너 4호는 1965년 6월 14일 화성을 지나며, 다른 행성의 근접 사진을 최초로 찍어냈다.\"},{\"document_id\":\"kowiki:213058\",\"paragraph_id\":\"p1\",\"quote\":\"1960년대 이후 궤도 위성 , 탐사선, 로버 등 수십 개의 무인 우주선 이 화성 으로 보내졌다.\"}]},{\"field\":\"대기 조성과 기압\",\"status\":\"covered\",\"reason\":\"대기의 주요 구성 성분으로 이산화탄소와 대기압 범위가 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:1964906\",\"paragraph_id\":\"p6\",\"quote\":\"화성의 대기의 주요 구성 성분인 이산화탄소\"},{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p19\",\"quote\":\"화성의 대기압은 0.6에서 1.0 kPa 로\"}]},{\"field\":\"온도와 측정 조건\",\"status\":\"needs_research\",\"reason\":\"특정 착륙 지점의 온도 범위는 있으나 행성의 온도 특성과 측정 조건을 설명하기에는 부족합니다.\",\"evidence\":[{\"document_id\":\"kowiki:1191338\",\"paragraph_id\":\"p20\",\"quote\":\"착륙 지점의 온도는 –127에서 40℃(-197에서 104℉)로 다를 수 있다.\"}]},{\"field\":\"자전축 기울기\",\"status\":\"covered\",\"reason\":\"자전축 기울기의 수치가 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p22\",\"quote\":\"화성의 자전축은 25.19도만큼 기울어져 있어서\"}]},{\"field\":\"자기장\",\"status\":\"covered\",\"reason\":\"현재 고유 자기장이 없다는 설명과 과거 표면의 자화 흔적이 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p8\",\"quote\":\"화성 자체의 자기장 은 없지만, 과거 행성 표면의 일부는 자화된 적이 있음이 관측을 통해 밝혀졌다.\"}]},{\"field\":\"표면 또는 대기 현상\",\"status\":\"covered\",\"reason\":\"극지의 얼음 지대가 표면 현상으로 설명되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p15\",\"quote\":\"화성은 극 지방이 얼음 과 이산화탄소 를 포함하는 얼음 지대로 덮여 있다.\"}]},{\"field\":\"고리\",\"status\":\"needs_research\",\"reason\":\"제공된 문단에서 고리의 존재 여부를 확인할 수 없습니다.\",\"evidence\":[]},{\"field\":\"위성계\",\"status\":\"covered\",\"reason\":\"화성의 두 위성인 포보스와 데이모스가 명시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:518\",\"paragraph_id\":\"p23\",\"quote\":\"포보스 (Phobos)와 데이모스 (Deimos)가 화성의 위성이다.\"}]}]}"
        }
