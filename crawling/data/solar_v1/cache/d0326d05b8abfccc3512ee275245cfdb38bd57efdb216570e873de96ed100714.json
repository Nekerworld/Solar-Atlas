          "text": "{\"facts\":[{\"field\":\"태양계 내 위치\",\"value\":\"태양에서 세 번째 행성이다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"태양 으로부터 세 번째 행성\"}]},{\"field\":\"행성 유형과 상대적 크기\",\"value\":\"암석과 금속으로 이루어진 지구형 행성으로, 지금까지 발견된 지구형 행성 가운데 가장 크다고 서술되어 있다.\",\"unit\":null,\"measurement_basis\":\"발견된 지구형 행성들과의 비교\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"지금까지 발견된 지구형 행성 가운데 가장 크다\"},{\"paragraph_id\":\"p12\",\"quote\":\"지구의 대부분은 수성 , 금성 , 화성 , 달 과 마찬가지로 암석 과 금속 으로 이루어져 있다.\"}]},{\"field\":\"형성 시기\",\"value\":\"약 45억 6,700만 년 전에 형성되었다고 서술되어 있다.\",\"unit\":\"년 전\",\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"지구는 45억 6700만 년 전 형성되었으며\"}]},{\"field\":\"자연위성\",\"value\":\"달을 유일한 자연위성으로 두며, 알려진 위성은 1개로 표에 기재되어 있다.\",\"unit\":\"개\",\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"지구의 유일한 자연위성인 달\"},{\"paragraph_id\":\"p57\",\"quote\":\"알려진 위성 1\"}]},{\"field\":\"대기\",\"value\":\"대기층으로 둘러싸여 있으며, 대기층은 조금 두껍다고 서술되어 있다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"조금 두꺼운 대기층 으로 둘러싸여 있고\"}]},{\"field\":\"질량\",\"value\":\"5.9736 × 10^24\",\"unit\":\"kg\",\"measurement_basis\":\"표에 기재된 물리적 특성\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"질량 5.9736 ×10 ^ 24 kg\"}]},{\"field\":\"평균 밀도\",\"value\":\"5.515\",\"unit\":\"g/cm³\",\"measurement_basis\":\"표에 기재된 물리적 특성\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"평균 밀도 5.515 g /cm 3\"}]},{\"field\":\"표면 중력\",\"value\":\"9.80665\",\"unit\":\"m/s²\",\"measurement_basis\":\"표에 기재된 물리적 특성\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"표면중력 9.80665 m/s 2\"}]},{\"field\":\"표면적\",\"value\":\"510,065,284.702\",\"unit\":\"km²\",\"measurement_basis\":\"표에 기재된 물리적 특성\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"표면적 510,065,284.702 km 2\"}]},{\"field\":\"자전 주기\",\"value\":\"23시간 56분 4.091초\",\"unit\":null,\"measurement_basis\":\"본문에 제시된 자전 주기\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p25\",\"quote\":\"지구는 23시간 56분 4.091초 주기로 자전하며\"}]},{\"field\":\"자전 방향\",\"value\":\"지구의 북극에서 보았을 때 시계 반대방향으로 자전한다.\",\"unit\":null,\"measurement_basis\":\"북극 방향에서 본 자전 방향\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p25\",\"quote\":\"그 방향은 지구의 북극에서 보았을 때 시계 반대방향이다.\"}]},{\"field\":\"공전 주기\",\"value\":\"365.2564 태양일\",\"unit\":\"태양일\",\"measurement_basis\":\"본문에 제시된 태양 주위 공전 주기\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p26\",\"quote\":\"지구는 태양을 365.2564 태양일 주기로 공전하고 있다.\"}]},{\"field\":\"궤도 긴반지름\",\"value\":\"149,597,870.7\",\"unit\":\"km\",\"measurement_basis\":\"표의 궤도 특성에 기재된 긴반지름\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"긴반지름 149,597,870.7 km\"}]},{\"field\":\"궤도 이심률\",\"value\":\"0.0167086\",\"unit\":null,\"measurement_basis\":\"표에 기재된 궤도 이심률\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"궤도 이심률 0.016 7086\"}]},{\"field\":\"평균 궤도 속도\",\"value\":\"초속 약 30\",\"unit\":\"km/s\",\"measurement_basis\":\"본문에 제시된 평균 궤도 속도\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p27\",\"quote\":\"지구의 궤도 속도는 평균 초속 30 km 정도인데\"}]},{\"field\":\"자전축 기울기\",\"value\":\"23.439281°\",\"unit\":\"도\",\"measurement_basis\":\"표에 기재된 자전축 기울기\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p57\",\"quote\":\"자전축 기울기 23.439 281°\"}]},{\"field\":\"내부 층상 구조\",\"value\":\"화학적 구성 성분의 변화를 기준으로 지각, 맨틀, 핵으로 구분하며 핵은 외핵과 내핵으로 나뉜다.\",\"unit\":null,\"measurement_basis\":\"화학적 구성 성분에 따른 구분\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p14\",\"quote\":\"가장 바깥부분부터 지각 , 맨틀 , 핵 (핵은 다시 외핵 과 내핵 으로 나뉜다.) 순이다. 이것은 화학적 구성 성분의 변화를 기준으로 구분한 것이다.\"}]},{\"field\":\"핵의 주요 구성 성분\",\"value\":\"철과 니켈이 주성분인 금속으로 서술되어 있다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p16\",\"quote\":\"핵은 맨틀이나 지각과는 달리 철 과 니켈 이 주성분인 금속 으로 되어 있다.\"}]},{\"field\":\"외핵의 상태\",\"value\":\"S파가 전달되지 않는다는 점을 근거로 액체 상태라고 추정하고 있다.\",\"unit\":null,\"measurement_basis\":\"S파가 전달되지 않는다는 관측에 근거한 추정\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p16\",\"quote\":\"외핵 은 S파 가 전달되지 못하는 것으로 보아 액체 상태로 되어 있다고 추정하고 있으며\"}]},{\"field\":\"내핵의 상태\",\"value\":\"고체 상태로 여겨진다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p16\",\"quote\":\"내핵은 고체 상태로 여겨진다.\"}]},{\"field\":\"표면 구성\",\"value\":\"표면은 대륙과 해양의 두 부분으로 나뉜다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p24\",\"quote\":\"지구의 표면은 대륙과 해양의 두 부분으로 나뉜다.\"}]},{\"field\":\"육지 평균 높이\",\"value\":\"840\",\"unit\":\"m\",\"measurement_basis\":\"본문에 제시된 육지의 평균 높이\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p24\",\"quote\":\"육지의 평균 높이는 840m인데\"}]}]}"
