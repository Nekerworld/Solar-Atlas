          "text": "{\"facts\":[{\"field\":\"천체 유형 및 모천체\",\"value\":\"천왕성을 도는 위성이다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"미란다 ( 영어 : Miranda ) 또는 천왕성 V ( 영어 : Uranus V )는 천왕성 의 둥근 다섯 개의 위성 중 가장 작고 가장 안쪽에 위치한 위성이다.\"}]},{\"field\":\"위성들 사이의 상대적 크기와 위치\",\"value\":\"천왕성의 둥근 다섯 위성 중 가장 작고 천왕성에 가장 가까운 안쪽 위성이다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"천왕성 의 둥근 다섯 개의 위성 중 가장 작고 가장 안쪽에 위치한 위성이다.\"}]},{\"field\":\"지름\",\"value\":\"약 470\",\"unit\":\"km\",\"measurement_basis\":\"본문에 제시된 근삿값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"미란다의 지름은 약 470 km\"}]},{\"field\":\"반지름\",\"value\":\"235.8±0.7\",\"unit\":\"km\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"반지름 235.8±0.7 km\"}]},{\"field\":\"질량\",\"value\":\"6.59×10^19\",\"unit\":\"kg\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"질량 6.59×10 ^ 19 kg\"}]},{\"field\":\"평균 밀도\",\"value\":\"1.2\",\"unit\":\"g/cm³\",\"measurement_basis\":\"본문에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"미란다의 밀도는 1.2 g/cm 3\"}]},{\"field\":\"표면 중력\",\"value\":\"0.079\",\"unit\":\"m/s²\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"표면 중력 0.079 m/s 2\"}]},{\"field\":\"탈출 속도\",\"value\":\"0.193\",\"unit\":\"km/s\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"탈출 속도 0.193 km/s\"}]},{\"field\":\"반사율\",\"value\":\"0.32\",\"unit\":null,\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"반사율 0.32\"}]},{\"field\":\"평균 온도\",\"value\":\"60\",\"unit\":\"K\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"평균 온도 60 K\"}]},{\"field\":\"공전 궤도 긴반지름\",\"value\":\"129390\",\"unit\":\"km\",\"measurement_basis\":\"표에 제시된 궤도 성질\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"궤도 긴반지름 (a) 129390 km\"}]},{\"field\":\"공전 주기\",\"value\":\"1.413479\",\"unit\":\"일\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"공전 주기 (P) 1.413479 일\"}]},{\"field\":\"평균 공전 속도\",\"value\":\"6.66\",\"unit\":\"km/s\",\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"평균 공전 속도 6.66 km/s\"}]},{\"field\":\"궤도 경사\",\"value\":\"본문과 표에 각각 4.34°와 4.232°로 기재되어 있어 값이 서로 다르다.\",\"unit\":\"°\",\"measurement_basis\":\"본문 및 표의 기재값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p6\",\"quote\":\"미란다의 궤도 경사 (4.34°)\"},{\"paragraph_id\":\"p30\",\"quote\":\"궤도 경사 (i) 4.232°\"}]},{\"field\":\"궤도 이심률\",\"value\":\"0.0013\",\"unit\":null,\"measurement_basis\":\"표에 제시된 값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"궤도 이심률 (e) 0.0013\"}]},{\"field\":\"자전 주기와 조석 고정\",\"value\":\"자전 주기는 1.413479일이며, 조석 고정되어 천왕성에 항상 같은 면을 향한다.\",\"unit\":\"일\",\"measurement_basis\":\"표의 자전 주기 및 본문의 조석 고정 설명\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p30\",\"quote\":\"자전 주기 1.413479 일 ( 동주기 자전 )\"},{\"paragraph_id\":\"p6\",\"quote\":\"달 처럼 조석 고정 되어 있어 천왕성을 향해 항상 한 쪽 면만을 보인다.\"}]},{\"field\":\"공전면과 계절\",\"value\":\"천왕성의 적도면에 가깝게 공전하며, 궤도는 황도에 대해 거의 수직이다. 천왕성의 기울어진 자전축 때문에 극적인 계절 주기가 반복된다.\",\"unit\":null,\"measurement_basis\":null,\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p1\",\"quote\":\"미란다는 천왕성의 적도면에 가깝게 공전한다.\"},{\"paragraph_id\":\"p1\",\"quote\":\"미란다의 궤도 또한 황도 에 대해 거의 수직이고 천왕성처럼 극적인 계절 주기가 반복된다.\"}]},{\"field\":\"표면 조성에 대한 추정\",\"value\":\"표면은 대부분 얼음인 것으로 보이며, 밀도에 근거해 얼음이 60% 이상 존재할 가능성이 제기되었다. 내부에는 규산염과 유기 물질이 있을 가능성도 제시되어 있다.\",\"unit\":null,\"measurement_basis\":\"밀도에 기반한 조성 추론 및 본문의 표면 조성 기술\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p7\",\"quote\":\"얼음이 60% 이상 존재할 가능성이 제기되었다.\"},{\"paragraph_id\":\"p7\",\"quote\":\"미란다의 표면은 대부분 얼음인 것으로 보이고, 밀도가 낮기 때문에 내부에 규산염 과 유기 물질 이 있을 가능성이 있다.\"}]},{\"field\":\"표면 지형\",\"value\":\"거친 지형과 거대한 협곡이 있으며, 베로나 절벽은 본문에서 약 5~10 km 높이로, 다른 설명에서는 약 5 km로 추정된다고 기술되어 있다.\",\"unit\":\"km\",\"measurement_basis\":\"본문의 지형 설명 및 높이 추정\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p2\",\"quote\":\"베로나 절벽 이라고 불리는 5~10 km 높이의 절벽\"},{\"paragraph_id\":\"p8\",\"quote\":\"높이는 약 5 km로 추정된다.\"}]},{\"field\":\"코로나 지형\",\"value\":\"남반구에 경주 트랙을 닮은 세 개의 큰 고랑 구조가 있으며, 길이 200 km, 깊이 20 km로 기술되어 있다.\",\"unit\":\"길이 km, 깊이 km\",\"measurement_basis\":\"본문의 남반구 지형 설명\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p9\",\"quote\":\"미란다의 남반구에는 \\\"경주 트랙\\\"을 닮은 세 개의 커다란 고랑 구조가 있는데, 길이는 200 km이고 깊이는 20 km로, 코로나 라고 불린다.\"}]},{\"field\":\"일부 지형의 연령\",\"value\":\"충돌구 개수 측정에 따르면 일부 지형은 1억 년보다 젊다.\",\"unit\":\"년\",\"measurement_basis\":\"충돌구 개수 측정\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p8\",\"quote\":\"충돌구 개수 측정을 통해 미란다의 지형 중 몇몇은 채 1억 년이 되지 않았다는 사실을 알 수 있고\"}]},{\"field\":\"현재 지질 활동 가능성\",\"value\":\"일부 지형이 젊다는 점을 바탕으로 미란다가 아직 지질학적으로 활동 중일 수 있다는 의문이 제기되었다.\",\"unit\":null,\"measurement_basis\":\"충돌구 개수에 따른 지형 연령 추론\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p8\",\"quote\":\"이를 통해 미란다가 아직도 지질학적으로 살아 있는 천체일 수 있다는 의문점이 제기된다.\"}]},{\"field\":\"과거 지질 활동의 원인 가설\",\"value\":\"움브리엘과의 과거 궤도 공명으로 조석 가열이 일어나 지질 활동을 유발했을 가능성이 제시되어 있다. 이 공명은 궤도 이심률을 높이고 천왕성의 기조력을 시간에 따라 변화시켜 내부를 가열했을 것으로 여겨진다.\",\"unit\":null,\"measurement_basis\":\"과거 궤도 공명 및 조석 가열에 대한 설명\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p11\",\"quote\":\"미란다의 과거 지질 활동은 움브리엘과의 궤도 공명으로 생겨난 조석 가열 로 인하여 일어났다고 여겨지고 있다.\"},{\"paragraph_id\":\"p11\",\"quote\":\"이 궤도 공명은 궤도 이심률 을 증가시켰을 것으로\"}]},{\"field\":\"코로나 형성 가설\",\"value\":\"코로나는 최상부의 다이어피어 현상이나 따뜻한 얼음이 위로 떠오르는 과정으로 형성되었을 가능성이 추정된다.\",\"unit\":null,\"measurement_basis\":\"지형 형성에 대한 해석\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p9\",\"quote\":\"최상부의 다이어피어 현상이나 따뜻한 얼음이 위로 떠올라서 생긴 지형으로 추정된다.\"}]},{\"field\":\"위성 재조립 가설\",\"value\":\"과거 거대한 운석 충돌로 미란다가 산산조각난 뒤 조각들이 다시 뭉쳐 현재 지형을 만들었다는 이론이 제시된 바 있다.\",\"unit\":null,\"measurement_basis\":\"보이저 2호 도착 직후 발표된 이론\",\"status\":\"hypothesis\",\"evidence\":[{\"paragraph_id\":\"p13\",\"quote\":\"미란다가 과거에 거대한 운석 충돌을 겪어 위성이 산산조각났다가 조각들이 다시 뭉쳐 현재의 기괴한 지형을 만들었다는 이론이 있었다.\"}]},{\"field\":\"발견\",\"value\":\"제러드 카이퍼가 1948년 2월 16일 발견했으며, 같은 해 3월 1일 천왕성 주위를 도는 모습이 확인되었다.\",\"unit\":null,\"measurement_basis\":\"본문의 발견 기록\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p5\",\"quote\":\"미란다는 1948년 2월 16일 천문학자 제러드 카이퍼 가 멕도널드 천문대의 2080 mm 오토 스트루베 망원경 을 사용하여 발견하였으며, 미란다가 천왕성 주변을 도는 모습은 같은 해 3월 1일에 확인되었다.\"}]},{\"field\":\"근접 관측\",\"value\":\"유일한 근접 사진은 1986년 1월 천왕성을 지나던 보이저 2호가 촬영했으며, 당시 남반구가 태양을 향해 있어 남반구에 대한 연구만 진행되었다고 기술되어 있다.\",\"unit\":null,\"measurement_basis\":\"보이저 2호 근접 통과 관측\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p4\",\"quote\":\"유일한 근접 사진은 1986년 1월 천왕성을 지나쳐가던 보이저 2호 가 촬영한 것으로, 근접통과 도중 미란다의 남반구가 태양을 보고 있었기 때문에 남반구에 대한 연구만 진행하였었다.\"}]},{\"field\":\"겉보기 등급\",\"value\":\"본문에는 +16.6, 표에는 15.8로 서로 다르게 기재되어 있다.\",\"unit\":\"등급\",\"measurement_basis\":\"본문 및 표의 겉보기 등급 기재값\",\"status\":\"established\",\"evidence\":[{\"paragraph_id\":\"p20\",\"quote\":\"미란다의 겉보기 등급은 +16.6으로\"},{\"paragraph_id\":\"p30\",\"quote\":\"겉보기등급 15.8\"}]}]}"
