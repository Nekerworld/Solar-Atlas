          "text": "{\"topics\":[{\"topic\":\"화성의 질량과 측정 기준\",\"query\":\"화성 질량 측정 단위\",\"reason\":\"체크리스트의 질량 항목을 확인하고, 제공된 질량 자료의 단위를 명확히 할 필요가 있습니다.\",\"question\":\"화성의 질량은 어떤 값과 단위로 제시되며, 측정 또는 산출 기준은 무엇인가?\"},{\"topic\":\"화성 대기 조성과 기압\",\"query\":\"화성 대기 조성 기압 측정 조건\",\"reason\":\"제공된 자료에는 기압 정보가 있지만 대기 조성과 기압값의 측정 조건은 충분히 확인되지 않습니다.\",\"question\":\"화성 대기의 주요 성분과 기압값의 범위·측정 조건은 무엇인가?\"},{\"topic\":\"화성 탐사와 관측\",\"query\":\"화성 탐사 우주선 관측\",\"reason\":\"관측과 탐사에 관한 체크리스트 항목을 뒷받침할 정보가 제공된 사실에 없습니다.\",\"question\":\"화성 탐사선의 주요 관측 결과와 탐사 활동은 무엇인가?\"},{\"topic\":\"화성의 고리\",\"query\":\"화성 고리 존재 여부\",\"reason\":\"체크리스트의 고리 항목에 관한 정보가 제공된 사실에 없으므로 별도로 확인해야 합니다.\",\"question\":\"화성에 고리가 있는지, 관련 관측이나 연구에서 확인된 내용은 무엇인가?\"}],\"questions\":[{\"question\":\"화성의 질량·대기 조성·기압을 신뢰할 수 있는 출처로 확인하고, 단위와 측정 조건을 구분했는가?\",\"required_fields\":[\"질량\",\"질량 단위\",\"대기 조성\",\"대기압\",\"측정 조건\",\"출처\"]},{\"question\":\"화성의 크기와 온도 자료에서 측정 기준이나 조건이 명시되어 있는가?\",\"required_fields\":[\"크기 값\",\"크기 측정 기준\",\"온도 값\",\"온도 측정 조건\",\"출처\"]},{\"question\":\"화성 탐사·관측 및 고리 항목에 대해 확인된 사실과 미확인 사항을 구분했는가?\",\"required_fields\":[\"탐사·관측 내용\",\"고리 관련 관측\",\"확인된 사실\",\"미확인 사항\",\"출처\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"found\",\"fact_indices\":[1,3]},{\"field\":\"질량\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"밀도\",\"status\":\"found\",\"fact_indices\":[2]},{\"field\":\"자전 주기와 태양일\",\"status\":\"found\",\"fact_indices\":[4,5]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[6,7,8]},{\"field\":\"구조와 조성\",\"status\":\"found\",\"fact_indices\":[14,15]},{\"field\":\"관측과 탐사\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"대기 조성과 기압\",\"status\":\"needs_research\",\"fact_indices\":[13]},{\"field\":\"온도와 측정 조건\",\"status\":\"needs_research\",\"fact_indices\":[12]},{\"field\":\"자전축 기울기\",\"status\":\"found\",\"fact_indices\":[9]},{\"field\":\"자기장\",\"status\":\"found\",\"fact_indices\":[19,20]},{\"field\":\"표면 또는 대기 현상\",\"status\":\"found\",\"fact_in