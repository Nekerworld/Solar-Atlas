          "text": "{\"topics\":[{\"topic\":\"공공의 크기와 측정 기준\",\"query\":\"225088 공공 반지름 지름 측정 기준\",\"reason\":\"크기와 측정 기준을 뒷받침하는 사실이 제공된 사실 목록에 없습니다.\",\"question\":\"공공의 크기는 어떤 관측·모형으로 추정되었으며, 반지름이나 지름의 추정 범위는 무엇인가?\"},{\"topic\":\"공공의 밀도와 내부 구조·조성\",\"query\":\"225088 공공 밀도 내부 구조 조성\",\"reason\":\"밀도와 내부 구조·조성을 확인할 자료가 필요합니다.\",\"question\":\"밀도 추정값과 그 근거는 무엇이며, 내부 구조와 조성은 관측 사실과 해석이 어떻게 구분되는가?\"},{\"topic\":\"공공의 자전과 태양일\",\"query\":\"225088 공공 자전 주기 태양일\",\"reason\":\"자전 주기 값은 있지만 태양일에 관한 내용은 제공된 사실에 없습니다.\",\"question\":\"공공의 태양일은 얼마이며, 자전 주기와 어떤 기준으로 구분되는가?\"},{\"topic\":\"공공 관측 및 탐사 자료\",\"query\":\"225088 공공 관측 탐사 허블 케플러\",\"reason\":\"관측 사례는 일부 언급되지만 관측·탐사 전반을 설명할 근거가 부족합니다.\",\"question\":\"공공에 관한 주요 관측·탐사 자료는 무엇이며, 각 자료가 어떤 특성을 측정했는가?\"}],\"questions\":[{\"question\":\"공공의 반지름·지름·밀도 값은 어떤 측정 또는 추정 방법과 불확실성에 근거하는가?\",\"required_fields\":[\"크기와 측정 기준\",\"밀도\"]},{\"question\":\"공공의 자전 주기와 태양일은 각각 얼마이며, 서로 어떤 차이가 있는가?\",\"required_fields\":[\"자전 주기와 태양일\"]},{\"question\":\"공공의 구조·조성 및 관측·탐사 기록에서 직접 관측된 내용과 가설은 어떻게 구분되는가?\",\"required_fields\":[\"구조와 조성\",\"관측과 탐사\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"질량\",\"status\":\"found\",\"fact_indices\":[0]},{\"field\":\"밀도\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[1]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[2,3,4,5,6]},{\"field\":\"구조와 조성\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"관측과 탐사\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"분류 근거\",\"status\":\"found\",\"fact_indices\":[6]},{\"field\":\"대기\",\"status\":\"found\",\"fact_indices\":[9]},{\"field\":\"표면\",\"status\":\"found\",\"fact_indices\":[8]},{\"field\":\"위성 관계\",\"status\":\"found\",\"fact_indices\":[10]},{\"field\":\"궤도 특성\",\"status\":\"found\",\"fact_indices\":[2,3,4,5,6]},{\"field\":\"왜소행성 후보 분류와 불확실성\",\"status\":\"found\",\"fact_indices\"