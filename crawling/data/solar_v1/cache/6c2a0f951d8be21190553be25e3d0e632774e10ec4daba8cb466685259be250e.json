    "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"ko\" dir=\"ltr\"><style data-mw-deduplicate=\"TemplateStyles:r40956678\">.mw-parser-output .infobox-subbox{padding:0;border:none;margin:-3px;width:auto;min-width:100%;font-size:100%;clear:none;float:none;background-color:transparent}.mw-parser-output .infobox-3cols-child{margin:auto}.mw-parser-output .infobox .navbar{font-size:100%}body.skin-minerva .mw-parser-output .infobox-header,body.skin-minerva .mw-parser-output .infobox-subheader,body.skin-minerva .mw-parser-output .infobox-above,body.skin-minerva .mw-parser-output .infobox-title,body.skin-minerva .mw-parser-output .infobox-image,body.skin-minerva .mw-parser-output .infobox-full-data,body.skin-minerva .mw-parser-output .infobox-below{text-align:center}</style><table class=\"infobox\" style=\"margin-left: 1em; float:right; width: 23em; font-size:85%\"><tbody><tr><th colspan=\"2\" class=\"infobox-above\" style=\"background:MidnightBlue; color:#ffffff; text-align:center;\">프시케 <span typeof=\"mw:File\"><a href=\"/wiki/%ED%8C%8C%EC%9D%BC:Psyche_symbol_(bold,_white).svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Psyche_symbol_%28bold%2C_white%29.svg/40px-Psyche_symbol_%28bold%2C_white%29.svg.png?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"24\" height=\"24\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Psyche_symbol_%28bold%2C_white%29.svg/60px-Psyche_symbol_%28bold%2C_white%29.svg.png?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"16\" data-file-height=\"16\" /></a></span><br /><span style=\"font-size:90%;\">16 Psyche</span></th></tr><tr><td colspan=\"2\" class=\"infobox-image\"><span class=\"mw-default-size\" typeof=\"mw:File\"><a href=\"/wiki/%ED%8C%8C%EC%9D%BC:000016-asteroid_shape_model_(16)_Psyche.png\" class=\"mw-file-description\" title=\"000016-asteroid_shape_model_(16)_Psyche\"><img alt=\"000016-asteroid_shape_model_(16)_Psyche\" src=\"//upload.wikimedia.org/wikipedia/commons/f/fd/000016-asteroid_shape_model_%2816%29_Psyche.png?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"250\" class=\"mw-file-element\" data-file-width=\"250\" data-file-height=\"250\" /></a></span></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background:MidnightBlue;color:#ffffff\">발견</th></tr><tr><th scope=\"row\" class=\"infobox-label\">발견자</th><td class=\"infobox-data\"><a href=\"/w/index.php?title=%EC%95%84%EB%8B%88%EB%B0%9C%EB%A0%88_%EB%8D%B0_%EA%B0%80%EC%8A%A4%ED%94%84%EB%A6%AC%EC%8A%A4&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"아니발레 데 가스프리스 (문서가 존재하지 않음)\">아니발레 데 가스프리스</a></td></tr><tr><th scope=\"row\" class=\"infobox-label\">발견일</th><td class=\"infobox-data\"><a href=\"/wiki/1852%EB%85%84\" title=\"1852년\">1852년</a> <a href=\"/wiki/3%EC%9B%94_17%EC%9D%BC\" title=\"3월 17일\">3월 17일</a></td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background:MidnightBlue;color:#ffffff\">궤도 성질</th></tr><tr><th scope=\"row\" class=\"infobox-label\">궤도 <a href=\"/wiki/%EA%B8%B4%EB%B0%98%EC%A7%80%EB%A6%84\" title=\"긴반지름\">긴반지름</a>(a)</th><td class=\"infobox-data\">2.921</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%9E%A5%EC%B6%95%EB%8B%A8\" title=\"장축단\">근일점</a>(q)</th><td class=\"infobox-data\">2.513</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%9E%A5%EC%B6%95%EB%8B%A8\" title=\"장축단\">원일점</a>(Q)</th><td class=\"infobox-data\">3.328</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EA%B3%B5%EC%A0%84_%EC%A3%BC%EA%B8%B0\" title=\"공전 주기\">공전 주기</a>(P)</th><td class=\"infobox-data\">4.99(1823.115일)</td></tr><tr><th scope=\"row\" class=\"infobox-label\">평균 <a href=\"/wiki/%EA%B3%B5%EC%A0%84_%EC%86%8D%EB%8F%84\" title=\"공전 속도\">공전 속도</a></th><td class=\"infobox-data\">17.34</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EA%B6%A4%EB%8F%84_%EA%B2%BD%EC%82%AC\" title=\"궤도 경사\">궤도 경사</a>(i)</th><td class=\"infobox-data\">3.095</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EA%B6%A4%EB%8F%84_%EC%9D%B4%EC%8B%AC%EB%A5%A0\" title=\"궤도 이심률\">궤도 이심률</a>(e)</th><td class=\"infobox-data\">0.140</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%8A%B9%EA%B5%90%EC%A0%90_%EA%B2%BD%EB%8F%84\" title=\"승교점 경도\">승교점 경도</a>(Ω)</th><td class=\"infobox-data\">150.352</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EA%B7%BC%EC%9D%BC%EC%A0%90_%ED%8E%B8%EA%B0%81\" class=\"mw-redirect\" title=\"근일점 편각\">근일점 편각</a>(ω)</th><td class=\"infobox-data\">228.047</td></tr><tr><th colspan=\"2\" class=\"infobox-header\" style=\"background:MidnightBlue;color:#ffffff\">물리적 성질</th></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EB%B6%84%EA%B4%91%ED%98%95\" class=\"mw-redirect\" title=\"분광형\">분광형</a></th><td class=\"infobox-data\">M</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%A7%80%EB%A6%84\" title=\"지름\">지름</a></th><td class=\"infobox-data\">240×185×145 km</td></tr><tr><th scope=\"row\" class=\"infobox-label\">평균 <a href=\"/wiki/%EB%B0%80%EB%8F%84\" title=\"밀도\">밀도</a></th><td class=\"infobox-data\">6.49±2.94 g/cm<sup>3</sup></td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%A7%88%EB%9F%89\" title=\"질량\">질량</a></th><td class=\"infobox-data\">2.19×10<sup>19</sup></td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%ED%83%88%EC%B6%9C_%EC%86%8D%EB%8F%84\" title=\"탈출 속도\">탈출 속도</a></th><td class=\"infobox-data\">0.13 km/s</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EB%B0%98%EC%82%AC%EC%9C%A8\" title=\"반사율\">반사율</a></th><td class=\"infobox-data\">0.120</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%9E%90%EC%A0%84_%EC%A3%BC%EA%B8%B0\" title=\"자전 주기\">자전 주기</a></th><td class=\"infobox-data\">4.196시간</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EA%B2%89%EB%B3%B4%EA%B8%B0%EB%93%B1%EA%B8%89\" title=\"겉보기등급\">겉보기등급</a></th><td class=\"infobox-data\">+9.22~+12.19</td></tr><tr><th scope=\"row\" class=\"infobox-label\"><a href=\"/wiki/%EC%A0%88%EB%8C%80%EB%93%B1%EA%B8%89\" title=\"절대등급\">절대등급</a>(H)</th><td class=\"infobox-data\">+5.90</td></tr><tr><th scope=\"row\" class=\"infobox-label\">평균 <a href=\"/wiki/%EC%98%A8%EB%8F%84\" title=\"온도\">온도</a></th><td class=\"infobox-data\">~160 K (최대: 280 K)</td></tr></tbody></table>\n<p><b>16 프시케</b>(<b>Psyche</b>)는 소행성대의 가장 무거운 10개의 소행성 중 하나이다. 프시케는 M형 소행성이기 때문에 다른 소행성보다 무겁다.\n</p><p>프시케는 1852년 3월 17일, <a href=\"/w/index.php?title=%EC%95%84%EB%8B%88%EB%B0%9C%EB%A0%88_%EB%8D%B0_%EA%B0%80%EC%8A%A4%ED%94%84%EB%A6%AC%EC%8A%A4&amp;action=edit&amp;redlink=1\" class=\"new\" title=\"아니발레 데 가스프리스 (문서가 존재하지 않음)\">가스프리스</a>가 <a href=\"/wiki/%EB%82%98%ED%8F%B4%EB%A6%AC\" title=\"나폴리\">나폴리</a>에서 발견했다. 프시케라는 이름은 그리스 신화에 등장하는 <a href=\"/wiki/%EC%97%90%EB%A1%9C%EC%8A%A4\" title=\"에로스\">에로스</a>의 아내인 <a href=\"/wiki/%ED%94%84%EC%8B%9C%EC%BC%80\" title=\"프시케\">프시케</a>의 이름에서 따온 이름이다. 처음 발견된 15개의 소행성은 천문학자들이 약칭으로 표기한 소행성이지만, 1851년 헨케는 원형 숫자를 사용하자고 제안했다. 그리하여 <a href=\"/wiki/%ED%94%84%EC%8B%9C%EC%BC%80\" title=\"프시케\">프시케</a>는 그것을 따라 표기된 최초의 소행성이다.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<meta property=\"mw:PageProp/toc\" />\n<div class=\"mw-heading mw-heading2\"><h2 id=\"특징\"><span id=\".ED.8A.B9.EC.A7.95\"></span>특징</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=16_%ED%94%84%EC%8B%9C%EC%BC%80&amp;veaction=edit&amp;section=1\" title=\"문단 편집: 특징\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=16_%ED%94%84%EC%8B%9C%EC%BC%80&amp;action=edit&amp;section=1\" title=\"문단의 원본 코드 편집: 특징\"><span>원본 편집</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p>레이다<sup id=\"cite&#95;ref-Ostro85&#95;2-0\" class=\"reference\"><a href=\"#cite_note-Ostro85-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-Magri99&#95;3-0\" class=\"reference\"><a href=\"#cite_note-Magri99-3\"><span class=\"cite-bracket\">&#91;</span>3<span class=\"cite-bracket\">&#93;</span></a></sup> 관측으로 프시케는 철-니켈로만 이루어져 있다는 것을 알았다. 프시케는 큰 분화된 모체로부터 금속 핵이 노출된 경우이다. 다른 M형 소행성들과 달리, 프시케는 금속체로의 해석과 일치하듯이 표면에 물의 흔적이 보이지 않는다.<sup id=\"cite&#95;ref-Merenyi97&#95;4-0\" class=\"reference\"><a href=\"#cite_note-Merenyi97-4\"><span class=\"cite-bracket\">&#91;</span>4<span class=\"cite-bracket\">&#93;</span></a></sup> 현재, 소량의 휘석이 나타난다.<sup id=\"cite&#95;ref-Hardersen05&#95;5-0\" class=\"reference\"><a href=\"#cite_note-Hardersen05-5\"><span class=\"cite-bracket\">&#91;</span>5<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>혹 프시케가 모체의 핵 찌꺼기라면, 다른 소행성과 비슷한 궤도일 것으로 기대한다. 프시케는 어떤 소행성족에도 속하지 않는다.<sup id=\"cite&#95;ref-Davis99&#95;6-0\" class=\"reference\"><a href=\"#cite_note-Davis99-6\"><span class=\"cite-bracket\">&#91;</span>6<span class=\"cite-bracket\">&#93;</span></a></sup> 한 가설은 태양계 초기시절에 어떤 충돌이 일어났고, 충돌 후에 단편화되었다고 추측한다.\n</p><p>프시케는 두 번의 엄폐 현상이 관측됐다. 광도 곡선의 변화로 봤을 때, 레이다 관측과 일치하듯이, 구형이 아닌 것으로 나타났다.\n</p>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"같이_보기\"><span id=\".EA.B0.99.EC.9D.B4_.EB.B3.B4.EA.B8.B0\"></span>같이 보기</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=16_%ED%94%84%EC%8B%9C%EC%BC%80&amp;veaction=edit&amp;section=2\" title=\"문단 편집: 같이 보기\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=16_%ED%94%84%EC%8B%9C%EC%BC%80&amp;action=edit&amp;section=2\" title=\"문단의 원본 코드 편집: 같이 보기\"><span>원본 편집</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/%EC%9A%B0%EC%A3%BC%EC%84%A0%EC%9D%B4_%EB%B0%A9%EB%AC%B8%ED%95%9C_%EC%86%8C%ED%96%89%EC%84%B1%EC%B2%B4%EC%99%80_%ED%98%9C%EC%84%B1_%EB%AA%A9%EB%A1%9D\" title=\"우주선이 방문한 소행성체와 혜성 목록\">우주선이 방문한 소행성체와 혜성 목록</a></li>\n<li><a href=\"/wiki/%EC%86%8C%ED%96%89%EC%84%B1_%EC%B1%84%EA%B5%B4\" title=\"소행성 채굴\">소행성 채굴</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"각주\"><span id=\".EA.B0.81.EC.A3.BC\"></span>각주</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=16_%ED%94%84%EC%8B%9C%EC%BC%80&amp;veaction=edit&amp;section=3\" title=\"문단 편집: 각주\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=16_%ED%94%84%EC%8B%9C%EC%BC%80&amp;action=edit&amp;section=3\" title=\"문단의 원본 코드 편집: 각주\"><span>원본 편집</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<div class=\"mw-references-wrap\"><ol class=\"references\">\n<li id=\"cite&#95;note-1\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-1\">↑</a></span> <span class=\"reference-text\"><cite class=\"citation web\">Hilton, J. (2001년 9월 17일). <a rel=\"nofollow\" class=\"external text\" href=\"https://www.webcitation.org/5msUtFmJu?url=http://aa.usno.navy.mil/faq/docs/minorplanets.php\">&#8220;When Did the Asteroids Become Minor Planets?&#8221;</a>. U.S. Naval Observatory. 2010년 1월 18일에 <a rel=\"nofollow\" class=\"external text\" href=\"http://aa.usno.navy.mil/faq/docs/minorplanets.php\">원본 문서</a>에서 보존된 문서<span class=\"reference-accessdate\">. 2007년 4월 3일에 확인함</span>.</cite><span title=\"ctx&#95;ver=Z39.88-2004&amp;rft&#95;val&#95;fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Abook&amp;rft.genre=unknown&amp;rft.btitle=When+Did+the+Asteroids+Become+Minor+Planets%3F&amp;rft.pub=U.S.+Naval+Observatory&amp;rft.date=2001-09-17&amp;rft.aulast=Hilton&amp;rft.aufirst=J.&amp;rft&#95;id=http%3A%2F%2Faa.usno.navy.mil%2Ffaq%2Fdocs%2Fminorplanets.php&amp;rfr&#95;id=info%3Asid%2Fko.wikipedia.org%3A16+%ED%94%84%EC%8B%9C%EC%BC%80\" class=\"Z3988\"><span style=\"display:none;\">&#160;</span></span></span>\n</li>\n<li id=\"cite&#95;note-Ostro85-2\"><span class=\"mw-cite-backlink\"><a href=\"#cite_ref-Ostro85_2-0\">↑</a></span> <span class=\"reference-text\"><cite class=\"citation journal\">S.J. Ostro (1985). <a rel=\"nofollow\" class=\"external text\" href=\"http://articles.adsabs.harvard.edu/cgi-bin/nph-iarticle_query?1985PASP...97..877O&amp;data_type=PDF_HIGH&amp;type=PRINTER&amp;filetype=.pdf\">&#8220;<i>Radar observations of asteroids and comets</i>&#8221;</a> <span style=\"font-size:85%;\">(PDF)</span>. &#12298;Astronomical Society of the Pacific, Publications&#12299; <b>97</b>: 877. <a href=\"/wiki/%EB%94%94%EC%A7%80%ED%84%B8_%EA%B0%9D%EC%B2%B4_%EC%8B%9D%EB%B3%84%EC%9E%90\" title=\"디지털 객체 식별자\">doi</a>:<a rel=\"nofollow\" class=\"external text\" data-mw-original-href=\"//dx.doi.org/10.1086%2F131619\" href=\"https://dx.doi.org/10.1086%2F131619\">10.1086/131619</a>.</cite><span title=\"ctx&#95;ver=Z39.88-2004&amp;rft&#95;val&#95;fmt=info%3Aofi%2Ffmt%3Akev%3Amtx%3Ajournal&amp;rft.genre=article&amp;rft.jtitle=Astronomical+Society+of+the+Pacific%2C+Publications&amp;rft.atitle=Radar+observations+of+asteroids+and+comets&amp;rft.volume=97&amp;rft.pages=877&amp;rft.date=1985&amp;rft&#95;id=info%3Adoi%2F10.1086%2F131619&amp;rft.au=S.J.+Ostro&amp;rft&#95;id=http%3A%2F%2Farticles.adsabs.harvard.edu%2Fcgi-bin%2Fnph-iarticle&#95;query%3F1985PASP...97..877O%26amp%3Bdata&#95;type%3DPDF&#95;HIGH%26amp%3Btype%3DPRINTER%26amp%3Bfiletype%3D.pdf&amp;rfr&#95;id=info%3Asid%2Fko.wikipedia.org%3A16+%ED%94%84%EC%8B%9C%EC%BC%80\" class=\"Z3988\"><span style=\"display:none;\">&#160;</span></span></span>\n</li>\n<li id=\"cite&#95;note-Magri99-3\"><span class