    "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"ko\" dir=\"ltr\"><p><b>1월 23일</b>은 <a href=\"/wiki/%EA%B7%B8%EB%A0%88%EA%B3%A0%EB%A6%AC%EB%A0%A5\" title=\"그레고리력\">그레고리력</a>으로 23번째 날에 해당한다.\n</p>\n<table class=\"toccolours navbox\" style=\"text-align:center; float:right; width:175px; margin-left:1em;\">\n\n<tbody><tr style=\"background:var(--background-color-progressive-subtle--active, #cbd6f6); color: var(--color-base, black);\">\n<td colspan=\"7\"><a href=\"/wiki/12%EC%9B%94\" title=\"12월\">12월</a> - <b><a href=\"/wiki/1%EC%9B%94\" title=\"1월\">1월</a></b> - <a href=\"/wiki/2%EC%9B%94\" title=\"2월\">2월</a>\n</td></tr>\n<tr style=\"background:var(--background-color-progressive-subtle, #f1f4fd);\">\n<td width=\"14%\"><a href=\"/wiki/%EC%9D%BC%EC%9A%94%EC%9D%BC\" title=\"일요일\"><span style=\"color:red;\">일</span></a>\n</td>\n<td width=\"14%\"><a href=\"/wiki/%EC%9B%94%EC%9A%94%EC%9D%BC\" title=\"월요일\"><span style=\"color: var(--color-base, black);\">월</span></a>\n</td>\n<td width=\"14%\"><a href=\"/wiki/%ED%99%94%EC%9A%94%EC%9D%BC\" title=\"화요일\"><span style=\"color: var(--color-base, black);\">화</span></a>\n</td>\n<td width=\"14%\"><a href=\"/wiki/%EC%88%98%EC%9A%94%EC%9D%BC\" title=\"수요일\"><span style=\"color: var(--color-base, black);\">수</span></a>\n</td>\n<td width=\"14%\"><a href=\"/wiki/%EB%AA%A9%EC%9A%94%EC%9D%BC\" title=\"목요일\"><span style=\"color: var(--color-base, black);\">목</span></a>\n</td>\n<td width=\"14%\"><a href=\"/wiki/%EA%B8%88%EC%9A%94%EC%9D%BC\" title=\"금요일\"><span style=\"color: var(--color-base, black);\">금</span></a>\n</td>\n<td width=\"14%\"><a href=\"/wiki/%ED%86%A0%EC%9A%94%EC%9D%BC\" title=\"토요일\"><span style=\"color:#0099ff;\">토</span></a>\n</td></tr>\n<tr>\n<td colspan=\"4\">\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_1%EC%9D%BC\" title=\"1월 1일\"><span style=\"color:var(--color-base, black);\">1</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_2%EC%9D%BC\" title=\"1월 2일\"><span style=\"color:var(--color-base, black);\">2</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_3%EC%9D%BC\" title=\"1월 3일\"><span style=\"color:#0099ff;\">3</span></a>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/1%EC%9B%94_4%EC%9D%BC\" title=\"1월 4일\"><span style=\"color:red;\">4</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_5%EC%9D%BC\" title=\"1월 5일\"><span style=\"color:var(--color-base, black);\">5</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_6%EC%9D%BC\" title=\"1월 6일\"><span style=\"color:var(--color-base, black);\">6</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_7%EC%9D%BC\" title=\"1월 7일\"><span style=\"color:var(--color-base, black);\">7</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_8%EC%9D%BC\" title=\"1월 8일\"><span style=\"color:var(--color-base, black);\">8</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_9%EC%9D%BC\" title=\"1월 9일\"><span style=\"color:var(--color-base, black);\">9</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_10%EC%9D%BC\" title=\"1월 10일\"><span style=\"color:#0099ff;\">10</span></a>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/1%EC%9B%94_11%EC%9D%BC\" title=\"1월 11일\"><span style=\"color:red;\">11</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_12%EC%9D%BC\" title=\"1월 12일\"><span style=\"color:var(--color-base, black);\">12</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_13%EC%9D%BC\" title=\"1월 13일\"><span style=\"color:var(--color-base, black);\">13</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_14%EC%9D%BC\" title=\"1월 14일\"><span style=\"color:var(--color-base, black);\">14</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_15%EC%9D%BC\" title=\"1월 15일\"><span style=\"color:var(--color-base, black);\">15</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_16%EC%9D%BC\" title=\"1월 16일\"><span style=\"color:var(--color-base, black);\">16</span></a>\n</td>\n<td><a href=\"/wiki/1%EC%9B%94_17%EC%9D%BC\" title=\"1월 17일\"><span style=\"color:#0099ff;\">17</span></a>\n</td></tr>\n<tr>\n<td><a href=\"/wiki/1%EC%9B%94_18%EC%9D%BC\" title=\"1월 18일\"><span style=\"color:r