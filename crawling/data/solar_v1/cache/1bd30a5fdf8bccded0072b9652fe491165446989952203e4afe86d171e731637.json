          "text": "{\"topics\":[{\"topic\":\"데이모스의 자전 주기와 태양일\",\"query\":\"데이모스 자전 주기 태양일\",\"reason\":\"자료에는 자전 주기와 조석 고정은 있지만 태양일 정보는 확인되지 않아 별도로 조사할 필요가 있습니다.\",\"question\":\"데이모스의 자전 주기와 태양일은 각각 어떻게 정의되며, 자료에 제시된 값은 어느 쪽인가요?\"},{\"topic\":\"데이모스의 구조와 조성\",\"query\":\"데이모스 내부 구조 조성\",\"reason\":\"자료에는 밀도에 근거한 조성 시사만 있어 내부 구조와 조성에 관한 근거를 더 확인해야 합니다.\",\"question\":\"데이모스의 내부 구조와 조성에 대해 관측으로 확인된 내용과 가설은 각각 무엇인가요?\"},{\"topic\":\"데이모스 탐사와 관측\",\"query\":\"데이모스 탐사 우주선 관측\",\"reason\":\"자료에는 발견 정보가 있지만 우주선 탐사나 후속 관측 내용은 제시되어 있지 않습니다.\",\"question\":\"데이모스에 관한 직접 관측 및 우주선 탐사 기록은 무엇이며, 각 기록이 제공한 정보는 무엇인가요?\"},{\"topic\":\"데이모스 크기 측정값 비교\",\"query\":\"데이모스 크기 반지름 삼축 크기\",\"reason\":\"자료에 반지름과 서로 다른 삼축 크기 표기가 있어 측정값과 측정 기준의 차이를 확인할 필요가 있습니다.\",\"question\":\"제시된 반지름 및 삼축 크기 값은 각각 어떤 측정 기준과 출처에 따른 것인가요?\"}],\"questions\":[{\"question\":\"데이모스의 크기와 질량에 제시된 값들이 서로 다를 때, 각 값의 측정 기준과 출처를 구분할 수 있는가?\",\"required_fields\":[\"크기와 측정 기준\",\"삼축 크기\",\"질량\"]},{\"question\":\"자전 주기와 태양일을 구분해 설명하고, 데이모스의 조석 고정에 관한 근거를 확인할 수 있는가?\",\"required_fields\":[\"자전 주기와 태양일\",\"조석 고정\"]},{\"question\":\"데이모스의 관측·탐사 기록과 구조·조성에 대해 확인된 사실을 가설과 구분해 제시할 수 있는가?\",\"required_fields\":[\"관측과 탐사\",\"구조와 조성\",\"기원 가설\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"found\",\"fact_indices\":[11,12,13]},{\"field\":\"질량\",\"status\":\"found\",\"fact_indices\":[14,15]},{\"field\":\"밀도\",\"status\":\"found\",\"fact_indices\":[16]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[10]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[3,4,5,6,7,8]},{\"field\":\"구조와 조성\",\"status\":\"needs_research\",\"fact_indices\":[20]},{\"field\":\"관측과 탐사\",\"status\":\"needs_research\",\"fact_indices\":[2]},{\"field\":\"모천체 관계\",\"status\":\"found\",\"fact_indices\":[0]},{\"field\":\"삼축 크기\",\"status\":\"found\",\"fact_indices\":[12,13]},{\"field\":\"조석 고정\",\"status\":\"found\",\"fact_indices\":[9,10]},{\"field\":\"표면\",\"status\":\"found\",\"fact_indices\":[18,19]},{\"field\":