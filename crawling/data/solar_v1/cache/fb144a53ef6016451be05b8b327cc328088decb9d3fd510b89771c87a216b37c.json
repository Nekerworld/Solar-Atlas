          "text": "{\"topics\":[{\"topic\":\"움브리엘의 자전과 조석 상태\",\"query\":\"움브리엘 자전 주기 태양일 조석 고정\",\"reason\":\"자전 주기, 태양일, 조석 고정 여부에 관한 근거가 제공된 사실에 없다.\",\"question\":\"움브리엘의 자전 주기와 조석 고정 여부는 무엇이며, 태양일은 어떻게 정의되는가?\"},{\"topic\":\"움브리엘의 관측과 탐사\",\"query\":\"움브리엘 보이저 2호 관측 탐사\",\"reason\":\"발견 연도와 발견자는 제시되어 있으나 탐사선 관측이나 탐사 자료는 확인되지 않았다.\",\"question\":\"어떤 관측·탐사 자료가 움브리엘의 물리적 특성과 표면을 뒷받침하는가?\"},{\"topic\":\"움브리엘의 크기와 밀도 측정\",\"query\":\"움브리엘 반지름 삼축 크기 밀도 측정\",\"reason\":\"지름과 밀도 값은 있으나 크기 측정 기준 및 삼축 크기 정보는 부족하며, 추가 검증이 유용하다.\",\"question\":\"움브리엘의 크기 측정 기준과 삼축 크기는 무엇이며, 자료에 제시된 밀도 값의 차이는 어떻게 설명되는가?\"},{\"topic\":\"움브리엘의 형성과 궤도 변화\",\"query\":\"움브리엘 형성 기원 가설 궤도 변화\",\"reason\":\"기원 가설과 궤도의 장기 변화에 관한 정보가 제공된 사실에 없다.\",\"question\":\"움브리엘의 기원에 관한 가설과 궤도 변화에 대해 어떤 근거가 제시되어 있는가?\"}],\"questions\":[{\"question\":\"지름·반지름·삼축 크기 자료가 어떤 측정 기준과 출처에 기반하는지 확인하고, 값의 불확실성도 구분할 수 있는가?\",\"required_fields\":[\"크기와 측정 기준\",\"삼축 크기\"]},{\"question\":\"밀도와 질량의 자료값이 서로 다른 출처에서 다르게 제시될 경우, 단위·측정 또는 추정 기준·불확실성을 확인해 차이를 설명할 수 있는가?\",\"required_fields\":[\"밀도\",\"질량\"]},{\"question\":\"움브리엘의 자전 주기, 태양일, 조석 고정 여부를 뒷받침하는 관측 근거를 확인할 수 있는가?\",\"required_fields\":[\"자전 주기와 태양일\",\"조석 고정\",\"관측과 탐사\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"found\",\"fact_indices\":[1,2,5]},{\"field\":\"질량\",\"status\":\"found\",\"fact_indices\":[6]},{\"field\":\"밀도\",\"status\":\"found\",\"fact_indices\":[3]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[4,7,8]},{\"field\":\"구조와 조성\",\"status\":\"found\",\"fact_indices\":[9,10,11,13]},{\"field\":\"관측과 탐사\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"모천체 관계\",\"status\":\"found\",\"fact_indices\":[8]},{\"field\":\"삼축 크기\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"조석 고정\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"표면\",\"status\":\"found\",\"fact_indices\":[9,10,11,12,13]},{\"field\":\"기원 가설\",\"sta