          "logprobs": [],
          "text": "{\"fields\":[{\"field\":\"크기와 측정 기준\",\"status\":\"covered\",\"reason\":\"핵의 크기와 측정 기준인 지름이 제시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p1\",\"quote\":\"혜성의 핵 의 지름은 약 4.8 km이다.\"}]},{\"field\":\"질량\",\"status\":\"needs_research\",\"reason\":\"질량 값이 제공된 문단에 없습니다.\",\"evidence\":[]},{\"field\":\"밀도\",\"status\":\"needs_research\",\"reason\":\"밀도 값이 제공된 문단에 없습니다.\",\"evidence\":[]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"reason\":\"자전 주기와 태양일은 확인되지 않습니다. 자전축 세차 주기는 자전 주기와 다른 값입니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p21\",\"quote\":\"엥케 혜성의 자전축은 81년을 주기로 세차 운동 을 일으키는데\"}]},{\"field\":\"공전과 궤도\",\"status\":\"covered\",\"reason\":\"공전 주기, 궤도 경사와 궤도 공명 관련 내용이 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p3\",\"quote\":\"엥케 혜성은 궤도 경사 가 매우 낮고 공전 주기 도 약 3년으로 작기 때문에\"}]},{\"field\":\"구조와 조성\",\"status\":\"covered\",\"reason\":\"낮은 반사율과 코마·꼬리를 이루는 기체 및 먼지에 관한 내용이 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p13\",\"quote\":\"꼬리 자체는 혜성에서 방출되는 먼지와 기체로 다시 원래대로 돌아갔다.\"},{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p1\",\"quote\":\"다른 혜성처럼 반사율 이 매우 낮으나(0.046), 근일점 접근 시에는 코마 가 생겨난다.\"}]},{\"field\":\"관측과 탐사\",\"status\":\"covered\",\"reason\":\"레이더·자외선 관측 및 탐사선의 관측과 탐사 시도가 기록되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p10\",\"quote\":\"1980년 엥케 혜성에 대한 레이더 관측이 이루어졌는데, 이는 혜성 중 최초였다.\"},{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p12\",\"quote\":\"2002년 엥케 혜성을 탐사하기 위해 컨투어 탐사선이 발사되었으나, 탐사선과의 통신이 두절되어 탐사에 실패하였다.\"}]},{\"field\":\"혜성 분류와 주기\",\"status\":\"covered\",\"reason\":\"주기 혜성으로 분류되며 공전 주기가 약 3.3년이라고 명시되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p1\",\"quote\":\"공전 주기 약 3.3년인 주기 혜성\"}]},{\"field\":\"근일점과 원일점\",\"status\":\"needs_research\",\"reason\":\"근일점과 원일점 거리는 제시되어 있으나, 마지막·다음 근일점 날짜는 시점에 따라 달라지는 정보이므로 최신 확인이 필요합니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p34\",\"quote\":\"원일점 4.098 AU 근일점 0.33960 AU\"},{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p34\",\"quote\":\"마지막 근일점 2023년 10월 22일 [ 2 ] 다음 근일점 2027년 2월 9일\"}]},{\"field\":\"핵의 크기와 조성\",\"status\":\"needs_research\",\"reason\":\"핵의 지름은 확인되지만 핵 자체의 조성은 제공된 문단에서 확인되지 않습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p1\",\"quote\":\"혜성의 핵 의 지름은 약 4.8 km이다.\"}]},{\"field\":\"코마와 꼬리\",\"status\":\"covered\",\"reason\":\"근일점 접근 시 코마가 생기며, 꼬리는 방출된 먼지와 기체로 구성된다고 설명합니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p1\",\"quote\":\"근일점 접근 시에는 코마 가 생겨난다.\"},{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p13\",\"quote\":\"꼬리 자체는 혜성에서 방출되는 먼지와 기체로 다시 원래대로 돌아갔다.\"}]},{\"field\":\"발견과 관측\",\"status\":\"covered\",\"reason\":\"최초 기록과 주기성 확인, 이후 귀환 확인 및 관측 기록이 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p1\",\"quote\":\"1786년 1월 17일 피에르 메생 이 처음 기록하였으며, 1819년 요한 프란츠 엥케 가 일정 주기마다 돌아오는 주기 혜성이라는 사실을 밝혀냈다.\"},{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p2\",\"quote\":\"1822년 6월 2일 시드니 천문대 의 카를 루트비히 크리스챤 륌케르 가 엥케 혜성이 돌아왔음을 확인하였다.\"}]},{\"field\":\"탐사\",\"status\":\"covered\",\"reason\":\"탐사선의 발사와 실패, 다른 탐사선의 혜성 관측이 기록되어 있습니다.\",\"evidence\":[{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p12\",\"quote\":\"엥케 혜성을 탐사하기 위해 컨투어 탐사선이 발사되었으나, 탐사선과의 통신이 두절되어 탐사에 실패하였다.\"},{\"document_id\":\"kowiki:296284\",\"paragraph_id\":\"p13\",\"quote\":\"2007년 4월 20일, STEREO-A 탐사선은 엥케 혜성의 꼬리가 코로나 질량 방출 에 따른 자기장 교란으로 인해 일시적으로 끊기는 모습을 포착하였다.\"}]}]}"
        }
