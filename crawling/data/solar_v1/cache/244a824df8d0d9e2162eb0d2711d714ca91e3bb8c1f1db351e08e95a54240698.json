          "text": "{\"topics\":[{\"topic\":\"레아의 자전 주기와 태양일\",\"query\":\"레아 자전 주기 태양일\",\"reason\":\"동주기 자전은 확인되지만, 태양일의 길이와 이를 설명하는 자료는 추가 확인이 필요합니다.\",\"question\":\"레아의 자전 주기와 태양일은 각각 어떻게 정의되고, 확인된 값은 무엇인가요?\"},{\"topic\":\"레아의 삼축 크기와 측정 기준\",\"query\":\"레아 위성 삼축 크기 반지름 측정\",\"reason\":\"반지름은 제시되어 있지만 삼축 크기와 크기 측정의 기준은 자료에 없습니다.\",\"question\":\"레아의 삼축 크기와 반지름 측정 기준은 무엇인가요?\"},{\"topic\":\"레아의 기원 가설과 궤도 변화\",\"query\":\"레아 위성 기원 가설 궤도 변화\",\"reason\":\"제공된 사실에는 레아의 기원 가설이나 궤도 변화의 설명이 없습니다. 관련 내용은 확립된 사실과 가설을 구분해 확인할 필요가 있습니다.\",\"question\":\"레아의 기원에 관한 주요 가설과 궤도 변화에 관해 확인된 내용은 무엇이며, 각각 어느 정도의 근거가 있나요?\"},{\"topic\":\"레아 고리 가설의 후속 관측\",\"query\":\"레아 고리 가설 카시니 후속 관측\",\"reason\":\"고리 정보는 가능성으로 제시되어 있으므로, 후속 관측에서 확인되었는지와 현재의 근거 수준을 조사할 필요가 있습니다.\",\"question\":\"레아의 고리 존재 가능성은 후속 관측에서 어떻게 평가되었나요?\"}],\"questions\":[{\"question\":\"크기 항목을 보완하기 위해 반지름 또는 삼축 크기의 측정 기준과 불확실성을 확인할 수 있는 자료가 있나요?\",\"required_fields\":[\"크기와 측정 기준\",\"삼축 크기\"]},{\"question\":\"동주기 자전 외에 레아의 자전 주기와 태양일을 구체적으로 확인할 자료가 있나요?\",\"required_fields\":[\"자전 주기와 태양일\",\"조석 고정\"]},{\"question\":\"레아의 기원 가설과 궤도 변화에 관한 주장은 무엇이며, 확립된 결과와 가설을 어떻게 구분해야 하나요?\",\"required_fields\":[\"기원 가설\",\"궤도 변화\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"질량\",\"status\":\"found\",\"fact_indices\":[5]},{\"field\":\"밀도\",\"status\":\"found\",\"fact_indices\":[6]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[8,9,10,11,12,13]},{\"field\":\"구조와 조성\",\"status\":\"found\",\"fact_indices\":[7,8]},{\"field\":\"관측과 탐사\",\"status\":\"found\",\"fact_indices\":[2,7]},{\"field\":\"모천체 관계\",\"status\":\"found\",\"fact_indices\":[0]},{\"field\":\"삼축 크기\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"조석 고정\",\"status\":\"found\",\"fact_indices\":[14]},{\"field\":\"표면\",\"status\":\"found\",\"fact_indices\":[18,19]},{\"field\":\"기원 가설\",\"status\":\"needs_resear