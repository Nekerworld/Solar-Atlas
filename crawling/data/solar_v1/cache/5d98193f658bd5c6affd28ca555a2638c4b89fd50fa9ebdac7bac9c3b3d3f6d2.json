          "text": "{\"topics\":[{\"topic\":\"테베의 질량과 밀도 및 크기 측정 기준 조사\",\"query\":\"테베 위성 질량 밀도 반지름 측정 방법\",\"reason\":\"제공된 자료에는 반지름과 삼축 크기가 있지만, 질량·밀도와 크기의 측정 방법 및 불확실성을 확인할 자료가 더 필요합니다.\",\"question\":\"신뢰할 수 있는 자료에서 테베의 질량과 밀도, 크기 측정 방법 및 불확실성을 확인할 수 있는가?\"},{\"topic\":\"테베의 자전 주기와 태양일 조사\",\"query\":\"테베 위성 자전 주기 태양일 조석 고정\",\"reason\":\"조석 고정이라는 정보는 있으나 자전 주기와 태양일의 값 또는 산출 근거는 제시되지 않았습니다.\",\"question\":\"테베의 자전 주기와 태양일은 무엇이며, 조석 고정 여부를 뒷받침하는 근거는 무엇인가?\"},{\"topic\":\"테베의 표면 조성과 기원 가설 조사\",\"query\":\"테베 위성 표면 조성 기원 가설\",\"reason\":\"표면이 아말테아와 비슷하다는 서술만으로는 표면 조성이나 형성 기원 가설을 확인할 수 없습니다.\",\"question\":\"테베의 표면 조성에 관한 근거와 제안된 기원 가설은 무엇이며, 각각의 불확실성은 무엇인가?\"},{\"topic\":\"테베의 궤도 변화와 테베 고리 관계 조사\",\"query\":\"테베 위성 궤도 변화 테베 고리 역학\",\"reason\":\"현재 궤도 수치는 있지만 궤도의 장기 변화 및 테베 고리와의 역학적 관계는 별도 확인이 필요합니다.\",\"question\":\"테베의 궤도가 시간에 따라 변하는지, 테베 고리와 어떤 역학적 관계가 있는지 자료로 확인할 수 있는가?\"}],\"questions\":[{\"question\":\"테베의 질량·밀도와 크기 측정 기준을 뒷받침하는 출처와 불확실성을 확인할 수 있는가?\",\"required_fields\":[\"질량\",\"밀도\",\"크기 측정 방법\",\"측정 불확실성\",\"출처\"]},{\"question\":\"테베의 자전 주기와 태양일, 조석 고정에 관한 근거를 확인할 수 있는가?\",\"required_fields\":[\"자전 주기\",\"태양일\",\"조석 고정 근거\",\"출처\"]},{\"question\":\"테베의 표면 조성·기원 가설과 궤도 변화에 관한 주장을 각각 근거 및 불확실성과 함께 확인할 수 있는가?\",\"required_fields\":[\"표면 조성\",\"기원 가설\",\"궤도 변화\",\"주장별 근거\",\"불확실성\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"needs_research\",\"fact_indices\":[3,17]},{\"field\":\"질량\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"밀도\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[23]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[4,10,11,12,13,14,15,16]},{\"field\":\"구조와 조성\",\"status\":\"needs_research\",\"fact_indices\":[7]},{\"field\":\"관측과 탐사\",\"status\":\"found\",\"fact_indices\":[8]},{\"field\":\"모천체 관계\",\"status\":\"found\",\"fact_indices\":[9]},{\"field\":\"삼축 크기\",\"status\":\"found\",\"fact_indices\":[3]},{\"field\":\"조석 고정\",\"