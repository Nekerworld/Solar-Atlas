          "text": "{\"topics\":[{\"topic\":\"타이탄의 크기와 측정 기준\",\"query\":\"타이탄 크기 지름 평균 반지름 측정 기준\",\"reason\":\"자료에는 지름과 평균 반지름이 있지만, 각 값의 측정 기준이나 정의가 충분히 드러나지 않아 출처와 기준을 확인할 필요가 있습니다.\",\"question\":\"지름과 평균 반지름은 어떤 측정 기준과 정의에 따른 값인가?\"},{\"topic\":\"타이탄의 태양일\",\"query\":\"타이탄 태양일 자전 주기\",\"reason\":\"공전 주기와 자전 주기가 같다는 내용은 있으나 태양일의 길이는 제시되어 있지 않습니다.\",\"question\":\"타이탄의 태양일은 얼마이며, 그 값을 산출하는 기준은 무엇인가?\"},{\"topic\":\"타이탄의 삼축 크기\",\"query\":\"타이탄 삼축 반지름 장축 단축\",\"reason\":\"평균 반지름은 있지만 서로 다른 세 축의 크기 자료는 제공된 사실에 없습니다.\",\"question\":\"타이탄의 세 축 방향 크기는 각각 얼마로 측정되었는가?\"},{\"topic\":\"타이탄의 궤도 변화\",\"query\":\"타이탄 궤도 진화 조석 이동\",\"reason\":\"현재 궤도 요소는 제시되어 있지만 시간에 따른 궤도 변화나 그 측정 근거는 확인되지 않습니다.\",\"question\":\"타이탄 궤도의 장기 변화는 어떤 관측이나 모형으로 조사되었는가?\"}],\"questions\":[{\"question\":\"타이탄의 지름·평균 반지름 측정 기준과 삼축 크기 자료를 각각 확인할 수 있는 신뢰할 만한 출처는 무엇인가?\",\"required_fields\":[\"크기와 측정 기준\",\"삼축 크기\"]},{\"question\":\"타이탄의 자전 주기와 구별되는 태양일의 길이 및 산출 기준은 무엇인가?\",\"required_fields\":[\"자전 주기와 태양일\"]},{\"question\":\"타이탄의 궤도가 시간에 따라 변한다는 근거와 그 변화의 측정 또는 모형 결과는 무엇인가?\",\"required_fields\":[\"궤도 변화\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"needs_research\",\"fact_indices\":[2,28]},{\"field\":\"질량\",\"status\":\"found\",\"fact_indices\":[32]},{\"field\":\"밀도\",\"status\":\"found\",\"fact_indices\":[3,31]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[36,37]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[4,5,6,21,22,23,24,25,26,27]},{\"field\":\"구조와 조성\",\"status\":\"found\",\"fact_indices\":[8,9,14,46,47]},{\"field\":\"관측과 탐사\",\"status\":\"found\",\"fact_indices\":[12,16,41,42,43]},{\"field\":\"모천체 관계\",\"status\":\"found\",\"fact_indices\":[20]},{\"field\":\"삼축 크기\",\"status\":\"needs_research\",\"fact_indices\":[]},{\"field\":\"조석 고정\",\"status\":\"found\",\"fact_indices\":[7,37]},{\"field\":\"표면\",\"status\":\"found\",\"fact_indices\":[8,10,11,12,13,41,42,43,44,45]},{\"field\":\"기원 가설\",\"status\":\"found\",\"fact_indices\":[17,18]},{