    "text": "<div class=\"mw-content-ltr mw-parser-output\" lang=\"ko\" dir=\"ltr\"><table class=\"infobox\" style=\"margin-left: 1em; float:right; width: 23em; font-size:85%\">\n\n<tbody><tr>\n<td colspan=\"2\" style=\"background:#FFC0C0; color:#000000; text-align:center;\"><big><big><b>데이모스</b></big></big> <br /><span style=\"font-size:90%;\">Deimos</span>\n</td></tr>\n\n<tr>\n<td colspan=\"2\" style=\"text-align: center;\"><span typeof=\"mw:File\"><a href=\"/wiki/%ED%8C%8C%EC%9D%BC:Deimos-MRO.jpg\" class=\"mw-file-description\"><img alt=\"MRO가 촬영한 데이모스\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Deimos-MRO.jpg/250px-Deimos-MRO.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"250\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Deimos-MRO.jpg/500px-Deimos-MRO.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"592\" data-file-height=\"592\" /></a></span><br />MRO가 촬영한 데이모스\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" colspan=\"2\">발견\n</th></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">발견자 </span>\n</th>\n<td><a href=\"/wiki/%EC%95%84%EC%82%AC%ED%94%84_%ED%99%80\" title=\"아사프 홀\">아사프 홀</a>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">발견일 </span>\n</th>\n<td><a href=\"/wiki/1877%EB%85%84\" title=\"1877년\">1877년</a> <a href=\"/wiki/8%EC%9B%94_12%EC%9D%BC\" title=\"8월 12일\">8월 12일</a>\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" bgcolor=\"#EAEAEA\" colspan=\"2\">명칭\n</th></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">다른 이름 </span>\n</th>\n<td>화성 II\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" bgcolor=\"#EAEAEA\" colspan=\"3\">궤도 성질 <br />\n</th></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%96%89%EC%84%B1\" title=\"행성\">모행성</a> </span>\n</th>\n<td><a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">화성</a>\n</td></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%9E%A5%EC%B6%95%EB%8B%A8\" title=\"장축단\">근점</a>(q) </span>\n</th>\n<td>23455.5 km\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%9E%A5%EC%B6%95%EB%8B%A8\" title=\"장축단\">원점</a>(Q) </span>\n</th>\n<td>23455.5 km\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B3%B5%EC%A0%84_%EC%A3%BC%EA%B8%B0\" title=\"공전 주기\">공전 주기</a>(P) </span>\n</th>\n<td>1일 6시간 17.9분<br />(1.2624일)\n</td></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B6%A4%EB%8F%84_%EA%B2%BD%EC%82%AC\" title=\"궤도 경사\">궤도 경사</a>(i) </span>\n</th>\n<td>1.788°\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B6%A4%EB%8F%84_%EC%9D%B4%EC%8B%AC%EB%A5%A0\" title=\"궤도 이심률\">궤도 이심률</a>(e) </span>\n</th>\n<td>0.00033\n</td></tr>\n\n<tr>\n<th style=\"background:#FFC0C0; color:#000000; text-align:center;\" colspan=\"2\">물리적 성질\n</th></tr>\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EB%B0%98%EC%A7%80%EB%A6%84\" title=\"반지름\">반지름</a> </span>\n</th>\n<td>6.2 ± 0.18 km\n</td></tr>\n\n\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%91%9C%EB%A9%B4%EC%A0%81\" class=\"mw-redirect\" title=\"표면적\">표면적</a> </span>\n</th>\n<td>15.0 × 12.0 × 11.0 km\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EB%B6%80%ED%94%BC\" title=\"부피\">부피</a> </span>\n</th>\n<td>999.78 km<sup>3</sup>\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">평균 <a href=\"/wiki/%EB%B0%80%EB%8F%84\" title=\"밀도\">밀도</a> </span>\n</th>\n<td>1.471 ± 0.166<br />g/cm³\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EC%A7%88%EB%9F%89\" title=\"질량\">질량</a> </span>\n</th>\n<td>1.8 ×10^15 kg\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">표면 <a href=\"/wiki/%EC%A4%91%EB%A0%A5\" title=\"중력\">중력</a> </span>\n</th>\n<td>0.0039 m/s2<br />(3.9mm/s2)\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%ED%83%88%EC%B6%9C_%EC%86%8D%EB%8F%84\" title=\"탈출 속도\">탈출 속도</a> </span>\n</th>\n<td>0.0069 km/s<br />(6.9m/s)\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EB%B0%98%EC%82%AC%EC%9C%A8\" title=\"반사율\">반사율</a> </span>\n</th>\n<td>0.068 ± 0.007\n</td></tr>\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">자전 주기 </span>\n</th>\n<td>1일 6시간 17.9분<br />(<a href=\"/wiki/%EC%A1%B0%EC%84%9D_%EA%B3%A0%EC%A0%95\" title=\"조석 고정\">조석 고정</a>)\n</td></tr>\n\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\"><a href=\"/wiki/%EA%B2%89%EB%B3%B4%EA%B8%B0%EB%93%B1%EA%B8%89\" title=\"겉보기등급\">겉보기등급</a> </span>\n</th>\n<td>12.89\n</td></tr>\n\n\n\n<tr>\n<th style=\"text-align: left;\"><span class=\"nowrap\">평균 <a href=\"/wiki/%EC%98%A8%EB%8F%84\" title=\"온도\">온도</a> </span>\n</th>\n<td>≈233<a href=\"/wiki/%EC%BC%88%EB%B9%88\" title=\"켈빈\">K</a>\n</td></tr>\n\n\n</tbody></table>\n<figure typeof=\"mw:File/Thumb\"><a href=\"/wiki/%ED%8C%8C%EC%9D%BC:Deimos-viking1.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Deimos-viking1.jpg/250px-Deimos-viking1.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"200\" height=\"204\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Deimos-viking1.jpg/500px-Deimos-viking1.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1015\" data-file-height=\"1033\" /></a><figcaption>데이모스</figcaption></figure>\n<p><b>데이모스</b>는 <a href=\"/wiki/%ED%99%94%EC%84%B1\" title=\"화성\">화성</a>의 두 <a href=\"/wiki/%EC%9C%84%EC%84%B1\" title=\"위성\">위성</a> 중 하나로 바깥 궤도를 돈다. <a href=\"/wiki/1877%EB%85%84\" title=\"1877년\">1877년</a> <a href=\"/wiki/8%EC%9B%94_12%EC%9D%BC\" title=\"8월 12일\">8월 12일</a> <a href=\"/wiki/%EC%95%84%EC%82%AC%ED%94%84_%ED%99%80\" title=\"아사프 홀\">아사프 홀</a>이 발견하였다.\n</p><p>데이모스는 <a href=\"/wiki/%ED%8F%AC%EB%B8%8C%EC%8A%A4\" title=\"포브스\">포브스</a>와 함께 원래 <a href=\"/wiki/%EC%86%8C%ED%96%89%EC%84%B1%EB%8C%80\" title=\"소행성대\">소행성대</a>에 있었다가 강력한 <a href=\"/wiki/%EB%AA%A9%EC%84%B1\" title=\"목성\">목성</a>의 인력으로 소행성대를 튀어나와 근처를 지나가던 화성에게 포획되었다는 설이 가장 인정받고 있다. 데이모스는 가장 긴 축이 화성을 향하고 있어서 <a href=\"/wiki/%EC%9E%90%EC%A0%84%EC%A3%BC%EA%B8%B0\" class=\"mw-redirect\" title=\"자전주기\">자전주기</a>와 <a href=\"/wiki/%EA%B3%B5%EC%A0%84%EC%A3%BC%EA%B8%B0\" class=\"mw-redirect\" title=\"공전주기\">공전주기</a>가 일치한다. 데이모스의 표면은 회색이며 매우 어둡고 평균 밀도(2g/cm<sup>3</sup> 이하)는 낮아 데이모스가 탄소질로 이루어졌음을 나타내며, 우주공간을 떠돌다 화성의 인력에 붙들린 소행성일 수도 있음을 시사하고 있다. 데이모스는 화성에서 점점 멀어지고 있으므로 언젠가는 화성을 탈출해 사라지게 될 것으로 예상하고 있다.\n</p>\n<table class=\"wikitable\">\n\n<tbody><tr>\n<th>위성 이름\n</th>\n<th>사진\n</th>\n<th>지름 (km)\n</th>\n<th>질량 (kg)\n</th>\n<th>궤도 평균 반지름\n</th>\n<th>공전 주기 (h)\n</th>\n<th>평균 삭망 주기\n</th></tr>\n<tr>\n<td><a class=\"mw-selflink selflink\">데이모스</a>\n</td>\n<td bgcolor=\"black\"><figure class=\"mw-halign-center\" typeof=\"mw:File\"><a href=\"/wiki/%ED%8C%8C%EC%9D%BC:Deimos-viking1.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Deimos-viking1.jpg/60px-Deimos-viking1.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"51\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/43/Deimos-viking1.jpg/120px-Deimos-viking1.jpg?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1015\" data-file-height=\"1033\" /></a><figcaption></figcaption></figure>\n</td>\n<td>12.4 km (10×12×16)\n</td>\n<td>2×10<span style=\"display:none\">^</span><sup>15</sup>\n</td>\n<td>23463.2 km(0.0001568418 AU)\n</td>\n<td>30.35\n</td>\n<td>5.44 일\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"같이_보기\"><span id=\".EA.B0.99.EC.9D.B4_.EB.B3.B4.EA.B8.B0\"></span>같이 보기</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%EB%8D%B0%EC%9D%B4%EB%AA%A8%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;veaction=edit&amp;section=1\" title=\"문단 편집: 같이 보기\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=%EB%8D%B0%EC%9D%B4%EB%AA%A8%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;action=edit&amp;section=1\" title=\"문단의 원본 코드 편집: 같이 보기\"><span>원본 편집</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r39133082\">.mw-parser-output .side-box{margin:4px 0;box-sizing:border-box;border:1px solid #aaa;font-size:88%;line-height:1.25em;background-color:var(--background-color-interactive-subtle,#f8f9fa);display:flow-root}.mw-parser-output .side-box-abovebelow,.mw-parser-output .side-box-text{padding:0.25em 0.9em}.mw-parser-output .side-box-image{padding:2px 0 2px 0.9em;text-align:center}.mw-parser-output .side-box-imageright{padding:2px 0.9em 2px 0;text-align:center}@media(min-width:500px){.mw-parser-output .side-box-flex{display:flex;align-items:center}.mw-parser-output .side-box-text{flex:1;min-width:0}}@media(min-width:720px){.mw-parser-output .side-box{width:238px}.mw-parser-output .side-box-right{clear:right;float:right;margin-left:1em}.mw-parser-output .side-box-left{margin-right:1em}}</style><div class=\"side-box metadata side-box-right plainlinks\"><style data-mw-deduplicate=\"TemplateStyles:r36480595\">.mw-parser-output .plainlist ol,.mw-parser-output .plainlist ul{line-height:inherit;list-style:none;margin:0;padding:0}.mw-parser-output .plainlist ol li,.mw-parser-output .plainlist ul li{margin-bottom:0}</style>\n<div class=\"side-box-flex\">\n<div class=\"side-box-image\"><span typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Commons-logo.svg/40px-Commons-logo.svg.png?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"30\" height=\"40\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4a/Commons-logo.svg/60px-Commons-logo.svg.png?utm_source=ko.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1024\" data-file-height=\"1376\" /></span></span></div>\n<div class=\"side-box-text plainlist\"><a href=\"/wiki/%EC%9C%84%ED%82%A4%EB%AF%B8%EB%94%94%EC%96%B4_%EA%B3%B5%EC%9A%A9\" title=\"위키미디어 공용\">위키미디어 공용</a>에 <span style=\"font-weight: bold;\"><a class=\"external text\" href=\"https://commons.wikimedia.org/wiki/Category:Deimos_(moon)?uselang=ko\">데이모스</a></span> 주제와 관련된 미디어 분류가 있습니다.</div></div>\n</div>\n<ul><li><a href=\"/wiki/%ED%99%94%EC%84%B1%EC%9D%98_%EC%9C%84%EC%84%B1\" title=\"화성의 위성\">화성의 위성</a></li>\n<li><a href=\"/wiki/%EA%B8%B0%EC%9B%90\" class=\"mw-disambig\" title=\"기원\">기원</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"외부_링크\"><span id=\".EC.99.B8.EB.B6.80_.EB.A7.81.ED.81.AC\"></span>외부 링크</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=%EB%8D%B0%EC%9D%B4%EB%AA%A8%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;veaction=edit&amp;section=2\" title=\"문단 편집: 외부 링크\" class=\"mw-editsection-visualeditor\"><span>편집</span></a><span class=\"mw-editsection-divider\"> | </span><a href=\"/w/index.php?title=%EB%8D%B0%EC%9D%B4%EB%AA%A8%EC%8A%A4_(%EC%9C%84%EC%84%B1)&amp;action=edit&amp;section=2\" title=\"문단의 원본 코드 편집: 외부 링크\"><span>원본 편집</span></a><span class