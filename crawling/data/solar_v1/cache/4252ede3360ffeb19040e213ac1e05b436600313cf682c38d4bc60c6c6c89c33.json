          "text": "{\"topics\":[{\"topic\":\"테티스의 삼축 크기와 크기 측정 기준\",\"query\":\"테티스 삼축 크기 반지름 지름 측정 기준\",\"reason\":\"현재 자료에는 지름과 반지름이 있지만 세 축의 치수와 측정 기준은 확인되지 않는다.\",\"question\":\"테티스의 세 축 치수는 무엇이며, 각 치수의 측정 기준과 출처는 무엇인가?\"},{\"topic\":\"테티스의 자전 주기와 태양일\",\"query\":\"테티스 자전 주기 태양일 동주기 자전\",\"reason\":\"동주기 자전이라는 사실은 있으나 자전 주기와 태양일의 구체적인 값은 자료에 제시되지 않는다.\",\"question\":\"테티스의 자전 주기와 태양일은 각각 얼마이며, 값의 기준은 무엇인가?\"},{\"topic\":\"테티스의 내부 구조와 조성\",\"query\":\"테티스 내부 구조 조성 지하 바다\",\"reason\":\"얼음과 물 위주의 조성은 제시되어 있지만 내부 구조에 관한 확립된 설명과 가설의 구분을 보강할 필요가 있다.\",\"question\":\"테티스의 내부 구조에 대해 확립된 내용과 가설은 각각 무엇인가?\"},{\"topic\":\"테티스의 궤도 변화\",\"query\":\"테티스 궤도 변화 디오네 궤도 공명\",\"reason\":\"현재 궤도 요소와 과거 공명에 관한 가설은 있으나 궤도 변화의 경과나 근거는 확인되지 않는다.\",\"question\":\"테티스의 궤도 변화가 연구된 바 있다면, 어떤 근거와 시간 범위에 기반하는가?\"}],\"questions\":[{\"question\":\"크기 자료에서 측정 기준과 삼축 치수가 확인되는가?\",\"required_fields\":[\"크기와 측정 기준\",\"삼축 크기\"]},{\"question\":\"동주기 자전 외에 자전 주기와 태양일의 값을 확인할 수 있는가?\",\"required_fields\":[\"자전 주기와 태양일\",\"조석 고정\"]},{\"question\":\"내부 구조 및 궤도 변화에 관한 정보 중 확립된 주장과 가설을 구분해 확인할 수 있는가?\",\"required_fields\":[\"구조와 조성\",\"궤도 변화\"]}],\"coverage\":[{\"field\":\"크기와 측정 기준\",\"status\":\"needs_research\",\"fact_indices\":[3,8]},{\"field\":\"질량\",\"status\":\"found\",\"fact_indices\":[7]},{\"field\":\"밀도\",\"status\":\"found\",\"fact_indices\":[6]},{\"field\":\"자전 주기와 태양일\",\"status\":\"needs_research\",\"fact_indices\":[10,16]},{\"field\":\"공전과 궤도\",\"status\":\"found\",\"fact_indices\":[9,10,11,12,13,31]},{\"field\":\"구조와 조성\",\"status\":\"needs_research\",\"fact_indices\":[5,27,28]},{\"field\":\"관측과 탐사\",\"status\":\"found\",\"fact_indices\":[25,32]},{\"field\":\"모천체 관계\",\"status\":\"found\",\"fact_indices\":[0]},{\"field\":\"삼축 크기\",\"status\":\"needs_research\",\"fact_indices\":[3,8]},{\"field\":\"조석 고정\",\"status\":\"found\",\"fact_indices\":[16]},{\"field\":\"표면\",\"status\":\"found\",\"fact_indices\":[19,20,21,22,23,24,25,26,30]},{\"field\":\"기원 가설\",\"status\":\"found\",\"fact_indices\"