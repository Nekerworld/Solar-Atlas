    },
    {
      "field": "온도",
      "value": "약 160",
      "unit": "K",
      "measurement_basis": null,
      "status": "established",
      "evidence": [
        {
          "paragraph_id": "p32",
          "quote": "Temperature ~160 K"
        }
      ],
      "item_id": "Q155017",
      "document_id": "enwiki:588642",
      "method": "llm",
      "validation_status": "evidence_quote_verified"
    },
    {
      "field": "관측된 표면 형상",
      "value": "2002~2007년 켁 천문대의 적응광학 장비를 사용한 켁 II 망원경 관측에서, 최소 두 개의 돌출부와 최소 하나의 평탄한 면이 확인되었다. 평탄한 면은 최적 타원체에서 15 km 벗어난다.",
      "unit": null,
      "measurement_basis": "켁 II 망원경 적응광학 영상 관측",
      "status": "established",
      "evidence": [
        {
          "paragraph_id": "p3",
          "quote": "From 2002 to 2007, astronomers at the Keck Observatory used the Keck II telescope, which is fitted with adaptive optics , to photograph Davida."
        },
        {
          "paragraph_id": "p3",
          "quote": "there are at least two promontories and at least one flat facet with 15-km deviations from a best-fit ellipsoid"
        }
      ],
      "item_id": "Q155017",
      "document_id": "enwiki:588642",
      "method": "llm",
      "validation_status": "evidence_quote_verified"
    },
    {
      "field": "평탄한 면의 기원",
      "value": "평탄한 면은 253 마틸데에서 관측된 것과 같은 지구적 규모의 약 150 km 충돌구일 가능성이 있다고 제안되었다.",
      "unit": null,
      "measurement_basis": "관측된 형상에 대한 해석",
      "status": "hypothesis",
      "evidence": [
        {
          "paragraph_id": "p3",
          "quote": "The facet is presumably a 150-km global-scale crater like the ones seen on 253 Mathilde"
        }
      ],
      "item_id": "Q155017",
      "document_id": "enwiki:588642",
      "method": "llm",
      "validation_status": "evidence_quote_verified"
    },
    {
      "field": "소행성대 질량 비중",
      "value": "소행성대 전체 질량의 약 1.5%를 차지하는 것으로 추정된다.",
      "unit": "%",
      "measurement_basis": "추정치",
      "status": "established",
      "evidence": [
        {
          "paragraph_id": "p2",
          "quote": "comprises an estimated 1.5% of the total mass of the asteroid belt"
        }
      ],
      "item_id": "Q155017",
      "document_id": "enwiki:588642",
      "method": "llm",
      "validation_status": "evidence_quote_verified"
    },
    {
      "field": "엄폐 관측",
      "value": "1987년 이후 엄폐 사건이 9회 관측되었으며, 그중 다수에서는 두세 개의 시각 현이 얻어졌다.",
      "unit": null,
      "measurement_basis": "1987년 이후의 엄폐 관측 기록",
      "status": "established",
      "evidence": [
        {
          "paragraph_id": "p6",
          "quote": "There have been 9 occultation events observed since 1987, many of which produced two or three chords"
        }
      ],
      "item_id": "Q155017",
      "document_id": "enwiki:588642",
      "method": "llm",
      "validation_status": "evidence_quote_verified"
    }
