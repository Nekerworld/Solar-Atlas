# Planner server. Copy to planner_backend/.env. Do not commit the copy.
PLANNER_HOST=127.0.0.1
PLANNER_PORT=8001
PLANNER_DB=planner_backend/data/planner.sqlite
PLANNER_LLM=gms
# GMS 엔드포인트(https://gms.ssafy.io/gmsapi/)와 모델(claude-haiku-5-5)은 코드에 고정되어 있어 설정하지 않는다.
GMS_KEY=
GOOGLE_MAPS_API_KEY=
# F3022 지식 검색이 호출하는 backend(FastAPI) 주소.
PLANNER_KNOWLEDGE_URL=http://127.0.0.1:8000
# Routes는 빈 응답 문제가 풀릴 때까지 끈다. 켜려면 true.
PLANNER_ROUTES_ENABLED=false
# Screen initial sky position. This is not the user's location.
PLANNER_INITIAL_LAT=37.5665
PLANNER_INITIAL_LON=126.9780
