# Static frontend deployment: Atlas stays hidden and makes no API requests.
VITE_ENABLE_ATLAS=false
# Set VITE_ENABLE_ATLAS=true to restore Atlas with a running backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_PLANNER_BASE_URL=http://127.0.0.1:8001
# 계획 상세의 구글 지도(Maps Embed API) 전용 브라우저 키. 서버용 GOOGLE_MAPS_API_KEY와 분리하고 HTTP 리퍼러(localhost:5173 등)로 제한한다.
VITE_GOOGLE_MAPS_EMBED_KEY=
